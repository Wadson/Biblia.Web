@page "/configuracoes"
@rendermode InteractiveServer
@inject Biblia.Application.Interfaces.IBackupService Backup
@inject Biblia.Application.Interfaces.IAppPaths Paths
<PageTitle>Configurações — BíbliaTema</PageTitle><PageHeader Title="Configurações" Eyebrow="SISTEMA" />
@if(note is not null){<div class="notice success">@note</div>}<section class="panel"><h2>Backup e restauração</h2><p>O backup contém manifesto e um snapshot consistente do banco do usuário. Dados ficam fora da pasta publicada.</p><a class="btn primary" href="/download/backup">Criar e baixar backup</a><div class="form-grid"><label>Restaurar arquivo ZIP<InputFile OnChange="Choose" accept=".zip" /></label>@if(uploadPath is not null){<ConfirmButton Label="Restaurar" Title="Restauração crítica" Message="Deseja restaurar este backup? Um backup de segurança será criado antes da substituição." Summary="@uploadName" Danger="true" CssClass="btn danger" OnConfirm="Restore" />}</div></section>
<section class="panel"><h2>Sobre</h2><p><strong>BíbliaTema Web</strong> · versão 1.0.0 · .NET 10</p><p class="muted">Aplicativo local, responsivo e com tema claro único.</p><p><strong>Diretório de dados:</strong> <span class="muted">Pasta local segura do usuário (não exposta na interface publicada).</span></p></section>
@code{string? uploadPath,uploadName,note;async Task Choose(InputFileChangeEventArgs e){var file=e.File;if(file.Size>200_000_000){note="Arquivo excede o limite de 200 MB.";return;}uploadName=Path.GetFileName(file.Name);uploadPath=Path.Combine(Paths.CacheDirectory,$"restore-{Guid.NewGuid():N}.zip");await using var input=file.OpenReadStream(200_000_000);await using var output=File.Create(uploadPath);await input.CopyToAsync(output);}async Task Restore(){if(uploadPath is null)return;await Backup.RestoreAsync(uploadPath);File.Delete(uploadPath);uploadPath=null;note="Backup restaurado e validado com sucesso.";}}
