@page "/status/{Code:int}"
<PageTitle>Erro @Code — BíbliaTema</PageTitle><section class="panel" style="max-width:650px;margin:10vh auto;text-align:center"><p class="eyebrow">BÍBLIATEMA</p><h1>@Code</h1><h2>@Title</h2><p class="muted">@Message</p><p><small>Código de correlação: @HttpContext?.TraceIdentifier</small></p><a class="btn primary" href="/">Voltar ao início</a></section>
@code{[Parameter]public int Code{get;set;}[CascadingParameter]public HttpContext? HttpContext{get;set;}string Title=>Code switch{400=>"Solicitação inválida",403=>"Acesso negado",404=>"Página não encontrada",409=>"Conflito de dados",_=>"Não foi possível concluir"};string Message=>Code==404?"O endereço solicitado não existe ou foi movido.":"Revise os dados e tente novamente.";}
