@page "/versoes"
@rendermode InteractiveServer
@inject Biblia.Application.Interfaces.IBibleVersionManager Manager
<PageTitle>Versões bíblicas — BíbliaTema</PageTitle><PageHeader Title="Versões bíblicas" Eyebrow="BÍBLIA" Subtitle="Gerencie as traduções instaladas e ativas." />
@if(message is not null){<div class="notice success">@message</div>}<div class="table-wrap"><table><thead><tr><th>Versão</th><th>Status</th><th>Validação</th><th>Ações</th></tr></thead><tbody>@foreach(var v in versions){<tr><td><strong>@v.Code</strong><br />@v.DisplayName<br /><small>@v.Language · schema @v.SchemaVersion</small></td><td>@(v.Code==active?"Ativa · ":"")@(v.IsEnabled?"Habilitada":"Desabilitada")<br />@(v.IsBundled?"Empacotada":"Importada")</td><td>@v.ValidationStatus<br /><small>@v.ValidationMessage</small></td><td><ConfirmButton Label="Definir ativa" Title="Alterar versão ativa" Message="Deseja definir esta versão como ativa?" Summary="@v.DisplayName" OnConfirm="()=>Activate(v.Code)" /> <ConfirmButton Label="@(v.IsEnabled?"Desativar":"Ativar")" Title="Alterar disponibilidade" Message="Deseja alterar a disponibilidade desta versão?" Summary="@v.Code" OnConfirm="()=>Toggle(v)" CssClass="btn secondary" /></td></tr>}</tbody></table></div>
@code{IReadOnlyList<BibleVersionCatalogEntry> versions=[];string? active,message;protected override async Task OnInitializedAsync()=>await Load();async Task Load(){versions=await Manager.GetVersionsAsync();active=(await Manager.GetActiveVersionAsync())?.Code;}async Task Activate(string code){await Manager.SetActiveVersionAsync(code);message="Versão ativa alterada com sucesso.";await Load();}async Task Toggle(BibleVersionCatalogEntry v){await Manager.SetEnabledAsync(v.Code,!v.IsEnabled);message="Disponibilidade alterada com sucesso.";await Load();}}
