@page "/cards"
@rendermode InteractiveServer
@inject Biblia.Application.Interfaces.IVerseCardService Cards
@inject Biblia.Application.Interfaces.INatureMediaService Media
<PageTitle>Estúdio de cards — BíbliaTema</PageTitle><PageHeader Title="Estúdio de cards" Eyebrow="COMPARTILHAR" />
@if(note is not null){<div class="notice success">@note</div>}<div class="form-grid"><section class="panel"><label class="field">Saudação<input @bind="greeting" /></label><label class="field">Tema<input @bind="theme" /></label><label class="field">Texto bíblico<textarea rows="6" @bind="text"></textarea></label><label class="field">Referência<input @bind="reference" /></label><label class="field">Versão<input @bind="version" /></label><label class="field">Formato<select @bind="format"><option>Retrato 4:5</option><option>Quadrado 1:1</option><option>Story 9:16</option></select></label><label class="field">Fundo<select @bind="background"><option value="0">Azul e verde</option><option value="1">Azul e dourado</option><option value="2">Violeta</option></select></label><ConfirmButton Label="Gerar PNG" Title="Gerar card" Message="Deseja gerar este arquivo de imagem?" Summary="@reference" OnConfirm="Render" /></section><section class="card" style="min-height:480px;background:linear-gradient(145deg,@Background.AverageColor,@Background.SecondaryColor);color:white;display:grid;place-content:center;text-align:center;padding:42px"><small>@greeting.ToUpperInvariant()</small><h2 style="color:#f3e5ab">@theme</h2><blockquote style="font:1.3rem Georgia;line-height:1.6">“@text”</blockquote><strong>@reference</strong><small>@version</small></section></div>
@if(download is not null){<p><a class="btn success" href="/download/card?path=@Uri.EscapeDataString(download)">Baixar PNG</a></p>}
@code{string greeting="Uma palavra para você",theme="Esperança",text="Digite ou cole aqui o texto bíblico.",reference="João 3:16",version="ACF",format="Retrato 4:5";int background;string? note,download;IReadOnlyList<NaturePhoto> backgrounds=[];NaturePhoto Background=>backgrounds.Count==0?new(-1,"","","BíbliaTema","","","#0D3B66",true,"#2A9D8F"):backgrounds[Math.Clamp(background,0,backgrounds.Count-1)];protected override void OnInitialized()=>backgrounds=Media.GetOfflineBackgrounds();async Task Render(){var result=await Cards.RenderAsync(new(greeting,theme,text,reference,version,Background,.45,format,"Clássico"));download=result.FilePath;note="Card gerado com sucesso.";}}
