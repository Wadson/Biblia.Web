@page "/relatorios"
@rendermode InteractiveServer
@inject Biblia.Application.Interfaces.IReportService ReportService
@inject Biblia.Application.Interfaces.IPdfService Pdf
@inject Biblia.Application.Interfaces.IThemeService Themes
@inject Biblia.Application.Interfaces.IBibleVersionManager Versions
<PageTitle>Relatórios — BíbliaTema</PageTitle><PageHeader Title="Relatório de temas e versículos" Eyebrow="SISTEMA" Subtitle="Exporte os vínculos temáticos em PDF A4." />
@if(error is not null){<div class="notice error" role="alert">@error</div>}@if(note is not null){<div class="notice success" role="status">@note</div>}
@if(stats is not null){<div class="stats"><div><b>@stats.Themes</b><span>Temas</span></div><div><b>@stats.References</b><span>Referências</span></div><div><b>@stats.ThemeVerseLinks</b><span>Vínculos</span></div></div>}
<section class="panel"><h2>Filtros</h2><div class="form-grid"><label>Tema<select @bind="themeId"><option value="0">Todos os temas</option>@foreach(var t in themes){<option value="@t.Id">@t.Name</option>}</select></label><label>Versão bíblica<select @bind="versionCode">@foreach(var v in versions){<option value="@v.Code">@v.DisplayName (@v.Code)</option>}</select></label><ConfirmButton Label="Gerar relatório" Title="Confirmar geração" Message="Deseja gerar o relatório PDF com os filtros informados?" Summary="@Summary" OnConfirm="Generate" /></div>
@if(pdfPath is not null){<p><a class="btn success" href="@($"/download/theme-report?path={Uri.EscapeDataString(pdfPath)}")">Baixar PDF gerado</a></p>}</section>
@code{ReportsOverview? stats;IReadOnlyList<Theme> themes=[];IReadOnlyList<BibleVersionCatalogEntry> versions=[];long themeId;string versionCode="";string? pdfPath,error,note;string Summary=>$"Tema: {(themeId==0?"Todos":themes.FirstOrDefault(x=>x.Id==themeId)?.Name)} | Versão: {versionCode}";protected override async Task OnInitializedAsync(){stats=await ReportService.GetOverviewAsync();themes=await Themes.SearchAsync(null);versions=(await Versions.GetVersionsAsync()).Where(x=>x.IsInstalled&&x.IsEnabled&&x.ValidationStatus!=BibleVersionValidationStatus.Incompatible).ToArray();versionCode=(await Versions.GetActiveVersionAsync())?.Code??versions.FirstOrDefault()?.Code??"";}async Task Generate(){try{error=null;if(string.IsNullOrWhiteSpace(versionCode))throw new InvalidOperationException("Selecione uma versão bíblica.");var report=await ReportService.BuildThemesAsync(new(themeId==0?null:themeId,versionCode));pdfPath=await Pdf.CreateThemeVersePdfAsync(report);note=$"Relatório gerado com {report.ThemeCount} tema(s) e {report.ReferenceCount} referência(s).";}catch(Exception ex){error=ex.Message;}}}
