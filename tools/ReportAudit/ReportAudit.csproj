<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <PublicationDirectory Condition="'$(PublicationDirectory)' == ''">C:\Program Files\Biblia.Web</PublicationDirectory>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="Biblia.Web.Core"><HintPath>$(PublicationDirectory)\Biblia.Web.Core.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
