@page "/vinculacoes"
@rendermode InteractiveServer
@inject Biblia.Application.Interfaces.IPublicationService Publications
@inject Biblia.Application.Interfaces.IThemeService Themes
@inject IJSRuntime JS

<PageTitle>Vinculações — BíbliaTema</PageTitle>
<div class="link-overview-page">
    <PageHeader Title="Visualização de vinculações" Eyebrow="ORGANIZAÇÃO" Subtitle="Consulte os temas e conteúdos associados a cada publicação." />
    <section class="panel link-filter-card"><div class="link-step-heading"><span>1</span><div><p class="eyebrow">FILTROS E PESQUISA</p><h2>Encontre uma vinculação</h2></div></div><div class="link-filter-grid"><label>Pesquisar título ou tema<input @bind="query" @bind:event="oninput" placeholder="Digite para pesquisar..." /></label><label>Data<select @bind="dateFilter"><option value="all">Todas as datas</option><option value="7">Atualizados nos últimos 7 dias</option><option value="30">Atualizados nos últimos 30 dias</option></select></label><label>Status<select @bind="statusFilter"><option value="all">Todos</option><option value="linked">Com temas vinculados</option><option value="none">Sem temas vinculados</option></select></label><button class="btn primary" @onclick="ApplyFilters"><AppIcon Name="search" Size="sm" /> Pesquisar</button></div></section>
    <section class="panel link-table-card"><div class="link-table-heading"><div class="link-step-heading"><span>2</span><div><p class="eyebrow">TABELA DE VINCULAÇÕES</p><h2>Publicações e temas</h2></div></div><button class="btn secondary" @onclick="ExportPdf"><AppIcon Name="report" Size="sm" /> Exportar lista em PDF</button></div><div class="table-wrap"><table class="link-table"><thead><tr><th>Publicação</th><th>Atualizado</th><th>Temas</th><th>Conteúdo</th><th></th></tr></thead><tbody>@if(!Filtered.Any()){<tr><td colspan="5" class="empty-themes">Nenhuma publicação encontrada.</td></tr>}else{@foreach(var item in Filtered){<tr class="@(selected?.Publication.Id==item.Publication.Id?"selected":"")"><td><strong>@(item.Publication.Title??item.Publication.Name)</strong></td><td>@item.Publication.UpdatedAt.LocalDateTime.ToString("dd/MM/yyyy")</td><td><span class="link-status @(item.Themes.Count>0?"linked":"empty")">@(item.Themes.Count>0?$"{item.Themes.Count} vinculado(s)":"Não vinculado")</span></td><td>@item.Verses versículo(s) · @item.Blocks bloco(s)</td><td><button class="btn secondary" @onclick="()=>ShowDetails(item)">Ver detalhes</button></td></tr>}}</tbody></table></div></section>
    @if(selected is not null){<section class="panel link-detail-card"><div class="link-step-heading"><span>3</span><div><p class="eyebrow">PAINEL DE DETALHES</p><h2>@(selected.Publication.Title??selected.Publication.Name)</h2><p>Temas e conteúdos vinculados a esta publicação.</p></div></div>@if(selected.Themes.Count==0){<p class="muted">Esta publicação ainda não possui temas vinculados.</p>}else{<div class="linked-theme-grid">@foreach(var theme in selected.Themes){<article><span class="theme-swatch" style="background:@theme.Theme.ColorHex"></span><div><strong>@theme.Theme.Name</strong><p>@theme.Verses versículo(s) · @theme.Blocks bloco(s)</p></div></article>}</div>}<a class="btn primary detail-open-action" href="/temas/vincular-versiculos"><AppIcon Name="add" Size="sm" /> Abrir na tela de Vinculação de Versículos</a></section>}
</div>

@code {
    sealed record ThemeLink(Theme Theme,int Verses,int Blocks);
    sealed record PublicationLink(Publication Publication,IReadOnlyList<ThemeLink> Themes){public int Verses=>Themes.Sum(x=>x.Verses);public int Blocks=>Themes.Sum(x=>x.Blocks);}
    IReadOnlyList<PublicationLink> links=[]; PublicationLink? selected; string query="",dateFilter="all",statusFilter="all";
    IEnumerable<PublicationLink> Filtered=>links.Where(item=>Matches(item));
    protected override async Task OnInitializedAsync(){var publications=await Publications.GetAllAsync();var themes=await Themes.SearchAsync(null);var result=new List<PublicationLink>();foreach(var publication in publications){var linked=new List<ThemeLink>();foreach(var theme in themes){var content=await Publications.GetContentAsync(publication.Id,theme.Id);if(content.Count>0)linked.Add(new(theme,content.Count(x=>x.ReferenceId is not null),content.Count(x=>x.TextBlock is not null)));}result.Add(new(publication,linked));}links=result;}
    bool Matches(PublicationLink item){var term=query.Trim();if(!string.IsNullOrWhiteSpace(term)&&!(item.Publication.Name.Contains(term,StringComparison.CurrentCultureIgnoreCase)||(item.Publication.Title?.Contains(term,StringComparison.CurrentCultureIgnoreCase)??false)||item.Themes.Any(x=>x.Theme.Name.Contains(term,StringComparison.CurrentCultureIgnoreCase))))return false;if(statusFilter=="linked"&&item.Themes.Count==0)return false;if(statusFilter=="none"&&item.Themes.Count>0)return false;if(int.TryParse(dateFilter,out var days)&&item.Publication.UpdatedAt< DateTimeOffset.UtcNow.AddDays(-days))return false;return true;}
    void ApplyFilters(){if(selected is not null&&!Filtered.Any(x=>x.Publication.Id==selected.Publication.Id))selected=null;}
    void ShowDetails(PublicationLink item)=>selected=item;
    Task ExportPdf()=>JS.InvokeVoidAsync("window.print").AsTask();
}
