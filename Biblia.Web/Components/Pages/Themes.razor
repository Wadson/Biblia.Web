@page "/temas"
@rendermode InteractiveServer
@inject Biblia.Application.Interfaces.IThemeService Service
<PageTitle>Temas — BíbliaTema</PageTitle><PageHeader Title="Temas" Eyebrow="ESTUDO" />
<div class="themes-page">
@if(note is not null){<div class="notice success">@note</div>}<section class="panel theme-editor"><div class="theme-section-heading"><div><p class="eyebrow">ORGANIZAÇÃO</p><h2>@(editId is null?"Novo tema":"Editar tema")</h2><p class="muted">Crie temas para reunir referências, versículos e blocos de estudo.</p></div><span class="theme-count">@themes.Count tema(s)</span></div><div class="form-grid"><label>Nome<input maxlength="100" @bind="name" placeholder="Ex.: Esperança" /></label><label class="theme-color-field">Cor<input type="color" @bind="color" title="Cor do tema" /></label><label>Descrição<input maxlength="500" @bind="description" placeholder="Descrição opcional" /></label><ConfirmButton Label="Salvar" Title="Confirmar tema" Message="Deseja salvar este tema?" Summary="@name" OnConfirm="Save" /></div></section>
<section class="theme-list-section"><div class="toolbar theme-filter"><label class="field">Pesquisar temas<input @bind="query" @bind:event="oninput" placeholder="Nome ou descrição" /></label><button class="btn secondary" @onclick="Load"><AppIcon Name="search" Size="sm" /> Filtrar</button></div><div class="table-wrap"><table><thead><tr><th>Tema</th><th>Descrição</th><th>Atualizado</th><th>Ações</th></tr></thead><tbody>@if(themes.Count==0){<tr><td colspan="4" class="empty-themes">Nenhum tema encontrado.</td></tr>}else{@foreach(var t in themes){<tr><td><span class="theme-swatch" style="background:@t.ColorHex"></span> <strong>@t.Name</strong></td><td>@(string.IsNullOrWhiteSpace(t.Description)?"Sem descrição.":t.Description)</td><td>@t.UpdatedAt.LocalDateTime.ToString("g")</td><td class="theme-actions"><a class="btn secondary" href="@($"/temas/vincular-versiculos?themeId={t.Id}")">Versículos e blocos</a><button class="btn secondary" @onclick="()=>Edit(t)">Editar</button><ConfirmButton Label="Excluir" Title="Exclusão" Message="Deseja realmente excluir este tema?" Summary="@t.Name" Danger="true" CssClass="btn danger" OnConfirm="()=>Delete(t.Id)" /></td></tr>}}</tbody></table></div></section>
</div>
@code{IReadOnlyList<Theme> themes=[];long? editId;string name="",color="#1769aa",description="",query="";string? note;protected override async Task OnInitializedAsync()=>await Load();async Task Load()=>themes=await Service.SearchAsync(query);void Edit(Theme t){editId=t.Id;name=t.Name;color=t.ColorHex??"#1769aa";description=t.Description??"";}async Task Save(){await Service.SaveAsync(editId,name,color,description);note="Tema salvo com sucesso.";editId=null;name=description="";await Load();}async Task Delete(long id){await Service.DeleteAsync(id);note="Tema excluído com sucesso.";await Load();}}

