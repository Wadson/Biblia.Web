@page "/temas"
@rendermode InteractiveServer
@inject Biblia.Application.Interfaces.IThemeService Service
<PageTitle>Temas — BíbliaTema</PageTitle><PageHeader Title="Temas" Eyebrow="ESTUDO" />
@if(note is not null){<div class="notice success">@note</div>}<section class="panel"><h2>@(editId is null?"Novo tema":"Editar tema")</h2><div class="form-grid"><label>Nome<input maxlength="100" @bind="name" /></label><label>Cor<input type="color" @bind="color" /></label><label>Descrição<input maxlength="500" @bind="description" /></label><ConfirmButton Label="Salvar" Title="Confirmar tema" Message="Deseja salvar este tema?" Summary="@name" OnConfirm="Save" /></div></section>
<div class="toolbar"><label class="field">Pesquisar<input @bind="query" @bind:event="oninput" /></label><button class="btn secondary" @onclick="Load">Filtrar</button></div><div class="table-wrap"><table><thead><tr><th>Tema</th><th>Descrição</th><th>Atualizado</th><th>Ações</th></tr></thead><tbody>@foreach(var t in themes){<tr><td><span style="background:@t.ColorHex;width:14px;height:14px;border-radius:50%;display:inline-block"></span> <strong>@t.Name</strong></td><td>@t.Description</td><td>@t.UpdatedAt.LocalDateTime.ToString("g")</td><td><a class="btn secondary" href="@($"/temas/vincular-versiculos?themeId={t.Id}")">Versículos e blocos</a> <button class="btn secondary" @onclick="()=>Edit(t)">Editar</button> <ConfirmButton Label="Excluir" Title="Exclusão!!" Message="Deseja realmente excluir este tema?" Summary="@t.Name" Danger="true" CssClass="btn danger" OnConfirm="()=>Delete(t.Id)" /></td></tr>}</tbody></table></div>
@code{IReadOnlyList<Theme> themes=[];long? editId;string name="",color="#1769aa",description="",query="";string? note;protected override async Task OnInitializedAsync()=>await Load();async Task Load()=>themes=await Service.SearchAsync(query);void Edit(Theme t){editId=t.Id;name=t.Name;color=t.ColorHex??"#1769aa";description=t.Description??"";}async Task Save(){await Service.SaveAsync(editId,name,color,description);note="Tema salvo com sucesso.";editId=null;name=description="";await Load();}async Task Delete(long id){await Service.DeleteAsync(id);note="Tema excluído com sucesso.";await Load();}}

