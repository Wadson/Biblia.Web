@page "/temas"
@rendermode InteractiveServer
@inject Biblia.Application.Interfaces.IThemeService Service
@inject Biblia.Application.Interfaces.IPublicationService Publications

<PageTitle>Temas — BíbliaTema</PageTitle>
<div class="themes-page">
    <PageHeader Title="Temas" Eyebrow="" />
    @if (note is not null) { <div class="notice success">@note</div> }
    <section class="panel theme-editor"><div class="theme-step-heading"><span>1</span><div><p class="eyebrow">CRIAR TEMA</p><div class="theme-step-title"><h2>@(editId is null ? "Crie um novo tema" : "Edite o tema")</h2><p>Vincule o tema a uma ou mais publicações, escolhendo uma por vez.</p></div></div><span class="theme-count">@themes.Count tema(s)</span></div>@if(!isEditing){<div class="theme-start"><p>Comece criando um tema para organizar seus versículos e blocos de estudo.</p><button class="btn primary" @onclick="New"><AppIcon Name="add" Size="sm" /> Novo tema</button></div>}else{<div class="theme-form"><label>Nome do tema *<input maxlength="100" @bind="name" placeholder="Insira o nome..." /></label><label class="color-field">Cor <span>(opcional)</span><input type="color" @bind="color" /></label><div class="theme-publication-picker"><label>Publicação / Título / PDF *<select @bind="publicationId"><option value="0">Selecione a publicação</option>@foreach(var publication in publications){<option value="@publication.Id">@(publication.Title??publication.Name)</option>}</select></label>@if(editId is not null){<button class="btn secondary" disabled="@(publicationId==0)" @onclick="AddPublication">Vincular publicação</button>}</div><div class="linked-publications"><span>Publicações vinculadas</span>@if(linkedPublications.Count==0){<p class="muted">Selecione uma publicação para vincular este tema.</p>}else{@foreach(var publication in linkedPublications){<div class="linked-publication"><span>@(publication.Title??publication.Name)</span><ConfirmButton Label="Remover" ConfirmLabel="Remover vínculo" Title="Remover publicação vinculada" Message="O conteúdo deste tema nesta publicação será removido. Deseja continuar?" Summary="@(publication.Title??publication.Name)" Danger="true" CssClass="btn danger" OnConfirm="()=>RemovePublication(publication.Id)" /></div>}}</div><div class="theme-form-actions"><button class="btn primary" @onclick="Save"><AppIcon Name="check" Size="sm" /> @(editId is null ? "Salvar tema" : "Salvar alterações")</button><button class="btn secondary" @onclick="Cancel">Cancelar</button></div></div>}</section>
    <section class="panel theme-search-card"><div class="theme-step-heading"><span>2</span><div><p class="eyebrow">PESQUISAR TEMAS</p><div class="theme-step-title"><h2>Encontre um tema criado</h2><p>Digite parte do nome para filtrar a lista de temas.</p></div></div></div><div class="theme-filter"><label>Pesquisar temas<input @bind="query" @bind:event="oninput" @bind:after="Load" placeholder="Digite para pesquisar..." /></label><button class="btn primary" @onclick="Load"><AppIcon Name="search" Size="sm" /> Pesquisar</button></div></section>
    <section class="table-wrap"><div class="theme-list-heading"><span>3</span><div><p class="eyebrow">TEMAS CRIADOS</p><h2>Gerencie seus temas</h2></div></div><table class="themes-table"><thead><tr><th>Tema</th><th>Publicações vinculadas</th><th class="theme-actions-heading">Ações</th></tr></thead><tbody>@if (!themes.Any()) { <tr><td colspan="3" class="empty-themes">Nenhum tema encontrado.</td></tr> } else { @foreach (var t in themes) { <tr><td><span class="theme-swatch" style="background:@t.ColorHex"></span><strong>@t.Name</strong></td><td class="theme-publications">@(publicationNames.GetValueOrDefault(t.Id,"Nenhuma publicação vinculada"))</td><td class="theme-actions"><button class="btn secondary" @onclick="()=>Edit(t)"><AppIcon Name="edit" Size="sm" /> Editar</button><ConfirmButton Label="Excluir" ConfirmLabel="Excluir" Title="Excluir tema" Message="Deseja realmente excluir este tema? Os vínculos e conteúdos relacionados também serão removidos." Summary="@t.Name" Danger="true" CssClass="btn danger" OnConfirm="()=>Delete(t.Id)" /></td></tr> } }</tbody></table></section>
</div>

@code { IReadOnlyList<Theme> themes=[];IReadOnlyList<Publication> publications=[];IReadOnlyList<Publication> linkedPublications=[];Dictionary<long,string> publicationNames=[];long? editId;long publicationId;bool isEditing;string name="",color="#1769aa",query="";string? note;protected override async Task OnInitializedAsync(){publications=await Publications.GetAllAsync();await Load();}async Task Load(){themes=await Service.SearchAsync(query);publicationNames=[];foreach(var theme in themes){var linked=await Publications.GetLinkedPublicationsAsync(theme.Id);publicationNames[theme.Id]=string.Join(", ",linked.Select(x=>x.Title??x.Name));}}void New(){editId=null;linkedPublications=[];publicationId=0;name="";color="#1769aa";isEditing=true;}async Task Edit(Theme t){editId=t.Id;name=t.Name;color=t.ColorHex??"#1769aa";linkedPublications=await Publications.GetLinkedPublicationsAsync(t.Id);publicationId=0;isEditing=true;}void Cancel(){editId=null;linkedPublications=[];publicationId=0;name="";color="#1769aa";isEditing=false;}async Task AddPublication(){if(editId is null||publicationId==0)return;await Publications.LinkThemeAsync(publicationId,editId.Value);linkedPublications=await Publications.GetLinkedPublicationsAsync(editId.Value);publicationId=0;await Load();}async Task RemovePublication(long id){if(editId is null)return;await Publications.UnlinkThemeAsync(id,editId.Value);linkedPublications=await Publications.GetLinkedPublicationsAsync(editId.Value);await Load();}async Task Save(){if(editId is null&&publicationId==0)throw new InvalidOperationException("Selecione ao menos uma publicação para vincular o tema.");var saved=await Service.SaveAsync(editId,name,color,null);if(publicationId>0)await Publications.LinkThemeAsync(publicationId,saved.Id);note="Tema salvo e publicações vinculadas atualizadas.";Cancel();await Load();}async Task Delete(long id){await Service.DeleteAsync(id);if(editId==id)Cancel();note="Tema excluído com sucesso.";await Load();} }
