@page "/temas"
@rendermode InteractiveServer
@inject Biblia.Application.Interfaces.IThemeService Service

<PageTitle>Temas — BíbliaTema</PageTitle>
<div class="themes-page">
    <PageHeader Title="Temas" Eyebrow="" />
    @if (note is not null) { <div class="notice success">@note</div> }
    <section class="panel theme-editor"><div class="theme-step-heading"><span>1</span><div><p class="eyebrow">CRIAR TEMA</p><div class="theme-step-title"><h2>@(editId is null ? "Crie um novo tema" : "Edite o tema")</h2><p>Temas são criados livremente e poderão ser vinculados a uma publicação depois.</p></div></div><span class="theme-count">@themes.Count tema(s)</span></div>@if(!isEditing){<div class="theme-start"><p>Comece criando um tema para organizar seus versículos e blocos de estudo.</p><button class="btn primary" @onclick="New"><AppIcon Name="add" Size="sm" /> Novo tema</button></div>}else{<div class="theme-form"><label>Nome do tema<input maxlength="100" @bind="name" placeholder="Insira o nome..." /></label><label class="color-field">Cor <span>(opcional)</span><input type="color" @bind="color" /></label><div class="theme-form-actions"><button class="btn primary" @onclick="Save"><AppIcon Name="check" Size="sm" /> Salvar tema</button><button class="btn secondary" @onclick="Cancel">Cancelar</button></div></div>}</section>
    <section class="panel theme-search-card"><div class="theme-step-heading"><span>2</span><div><p class="eyebrow">PESQUISAR TEMAS</p><div class="theme-step-title"><h2>Encontre um tema criado</h2><p>Digite parte do nome para filtrar a lista de temas.</p></div></div></div><div class="theme-filter"><label>Pesquisar temas<input @bind="query" @bind:event="oninput" @bind:after="Load" placeholder="Digite para pesquisar..." /></label><button class="btn primary" @onclick="Load"><AppIcon Name="search" Size="sm" /> Pesquisar</button></div></section>
    <section class="table-wrap"><div class="theme-list-heading"><span>3</span><div><p class="eyebrow">TEMAS CRIADOS</p><h2>Gerencie seus temas</h2></div></div><table class="themes-table"><thead><tr><th>Tema</th><th>Atualizado</th><th>Status</th><th>Ações</th></tr></thead><tbody>@if (!themes.Any()) { <tr><td colspan="4" class="empty-themes">Nenhum tema encontrado.</td></tr> } else { @foreach (var t in themes) { <tr><td><span class="theme-swatch" style="background:@t.ColorHex"></span><strong>@t.Name</strong></td><td>@t.UpdatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</td><td class="theme-status">Disponível para vinculação</td><td class="theme-actions"><button class="btn secondary" @onclick="()=>Edit(t)"><AppIcon Name="edit" Size="sm" /> Editar</button><ConfirmButton Label="Excluir" ConfirmLabel="Excluir" Title="Excluir tema" Message="Deseja realmente excluir este tema? Os vínculos e conteúdos relacionados também serão removidos." Summary="@t.Name" Danger="true" CssClass="btn danger" OnConfirm="()=>Delete(t.Id)" /></td></tr> } }</tbody></table></section>
</div>

@code { IReadOnlyList<Theme> themes=[];long? editId;bool isEditing;string name="",color="#1769aa",query="";string? note;protected override Task OnInitializedAsync()=>Load();async Task Load()=>themes=await Service.SearchAsync(query);void New(){editId=null;name="";color="#1769aa";isEditing=true;}void Edit(Theme t){editId=t.Id;name=t.Name;color=t.ColorHex??"#1769aa";isEditing=true;}void Cancel(){editId=null;name="";color="#1769aa";isEditing=false;}async Task Save(){await Service.SaveAsync(editId,name,color,null);note="Tema salvo com sucesso.";Cancel();await Load();}async Task Delete(long id){await Service.DeleteAsync(id);if(editId==id)Cancel();note="Tema excluído com sucesso.";await Load();} }
