@page "/temas"
@rendermode InteractiveServer
@inject Biblia.Application.Interfaces.IThemeService Service
@inject Biblia.Application.Interfaces.IPublicationService Publications
<PageTitle>Temas — BíbliaTema</PageTitle><PageHeader Title="Temas" Eyebrow="ESTUDO" />
<div class="themes-page">@if(note is not null){<div class="notice success">@note</div>}<section class="panel theme-editor"><div class="theme-heading"><div><p class="eyebrow">ORGANIZAÇÃO</p><div class="title-line"><h2>@(editId is null?"Novo tema":"Editar tema")</h2><span>Crie temas para reunir referências, versículos e blocos de estudo.</span></div></div><span class="theme-count">@themes.Count tema(s)</span></div><div class="theme-form"><label>Nome<input maxlength="100" @bind="name" placeholder="Insira o nome..." /></label><label class="color-field">Cor<input type="color" @bind="color" /></label><button class="btn primary" @onclick="Save"><AppIcon Name="check" Size="sm" /> @(editId is null?"Salvar":"Salvar alterações")</button>@if(editId is not null){<button class="btn secondary" @onclick="Cancel">Cancelar</button>}</div></section><section class="theme-filter"><label>Pesquisar temas<input @bind="query" @bind:event="oninput" /></label><label>Publicação<select @bind="publicationId"><option value="">Todas</option>@foreach(var p in publications){<option value="@p.Id">@p.Name</option>}</select></label>@if(publicationId is not null){<label>Situação<select @bind="statusFilter"><option value="all">Todos</option><option value="complete">Vinculados</option><option value="none">Não vinculados</option></select></label>}<button class="btn primary" @onclick="Load"><AppIcon Name="search" Size="sm" /> Filtrar</button></section><section class="table-wrap"><table class="themes-table"><thead><tr><th>Tema</th><th>Atualizado</th>@if(publicationId is not null){<th>Publicação</th>}<th>Ações</th></tr></thead><tbody>@if(!VisibleThemes.Any()){<tr><td colspan="4" class="empty-themes">Nenhum tema encontrado.</td></tr>}else{@foreach(var t in VisibleThemes){var status=Status(t.Id);<tr><td><span class="theme-swatch" style="background:@t.ColorHex"></span><strong>@t.Name</strong></td><td>@t.UpdatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</td>@if(publicationId is not null){<td>@(status==PublicationThemeStatus.Complete?"✓ Vinculado":status==PublicationThemeStatus.Partial?"◐ Parcial":"Não vinculado")</td>}<td class="theme-actions"><button class="btn secondary" @onclick="()=>Edit(t)"><AppIcon Name="edit" Size="sm" /> Editar</button><a class="btn primary" href="@($"/temas/vincular-versiculos?themeId={t.Id}")"><AppIcon Name="list" Size="sm" /> Versículos e blocos</a>@if(publicationId is long p){<button class="btn secondary" @onclick="()=>Toggle(p,t.Id,status)">@(status==PublicationThemeStatus.Complete?"Desvincular":status==PublicationThemeStatus.Partial?"Completar":"Vincular")</button>}</td></tr>}}</tbody></table></section></div>
@code{IReadOnlyList<Theme> themes=[];IReadOnlyList<Publication> publications=[];Dictionary<long,PublicationThemeStatus> statuses=[];long? publicationId,editId;string name="",color="#1769aa",query="",statusFilter="all";string? note;IEnumerable<Theme> VisibleThemes=>themes.Where(t=>publicationId is null||statusFilter=="all"||(statusFilter=="complete"&&Status(t.Id)==PublicationThemeStatus.Complete)||(statusFilter=="none"&&Status(t.Id)==PublicationThemeStatus.None));protected override async Task OnInitializedAsync(){publications=await Publications.GetAllAsync();await Load();}PublicationThemeStatus Status(long id)=>statuses.TryGetValue(id,out var s)?s:PublicationThemeStatus.None;async Task Load(){themes=await Service.SearchAsync(query);statuses=[];if(publicationId is long p)foreach(var t in themes)statuses[t.Id]=await Publications.GetThemeStatusAsync(p,t.Id);}void Edit(Theme t){editId=t.Id;name=t.Name;color=t.ColorHex??"#1769aa";}void Cancel(){editId=null;name="";color="#1769aa";}async Task Save(){await Service.SaveAsync(editId,name,color,null);note="Tema salvo com sucesso.";Cancel();await Load();}async Task Toggle(long p,long t,PublicationThemeStatus s){if(s==PublicationThemeStatus.Complete)await Publications.UnlinkThemeAsync(p,t);else await Publications.LinkCompleteThemeAsync(p,t);await Load();}}
