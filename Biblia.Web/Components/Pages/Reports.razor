@page "/relatorios"
@rendermode InteractiveServer
@inject Biblia.Application.Interfaces.IReportService ReportService
@inject Biblia.Application.Interfaces.IPdfService Pdf
@inject Biblia.Application.Interfaces.IThemeService Themes
@inject Biblia.Application.Interfaces.IPublicationService Publications
@inject ILogger<Reports> Logger
<PageTitle>Relatórios — BíbliaTema</PageTitle><PageHeader Title="Relatório de temas e versículos" Eyebrow="SISTEMA" Subtitle="Exporte os vínculos temáticos em PDF A4." />
@if(error is not null){<div class="notice error" role="alert">@error</div>}@if(note is not null){<div class="notice success" role="status">@note</div>}
<div class="report-page">@if(stats is not null){<div class="report-summary-grid"><div class="report-stat-card"><AppIcon Name="theme" /><b>@stats.Themes</b><span>Temas</span></div><div class="report-stat-card"><AppIcon Name="book" /><b>@stats.References</b><span>Referências</span></div><div class="report-stat-card"><AppIcon Name="compare" /><b>@stats.ThemeVerseLinks</b><span>Vínculos</span></div></div>}
<section class="panel report-filter-card"><header class="report-filter-header"><div class="report-step"><span>1</span><div><p class="eyebrow">GERAR RELATÓRIO</p><h2>Configure a publicação</h2><p>Escolha o livro e os temas que farão parte do PDF.</p></div></div><div class="report-publication-context"><AppIcon Name="book" Size="sm" /><span>@(SelectedPublication?.Title??SelectedPublication?.Name??"Nenhuma publicação selecionada")</span></div></header><div class="form-grid report-filter-grid"><label><span>Publicação / PDF <b>*</b></span><select @bind="publicationId" @bind:after="PublicationChanged"><option value="0">Selecione a publicação</option>@foreach(var p in publications){<option value="@p.Id">@(p.Title??p.Name)</option>}</select></label><label><span>Tema</span><select @bind="themeId" disabled="@(publicationId==0)"><option value="0">Todos os temas</option>@foreach(var t in themes){<option value="@t.Id">@t.Name</option>}</select></label><div class="report-actions"><p>@(publicationId==0?"Selecione uma publicação para habilitar a geração.":"O título definido na publicação será usado automaticamente no PDF.")</p><ConfirmButton Label="Gerar relatório" Title="Confirmar geração" Message="Deseja gerar o relatório PDF com os filtros informados?" Summary="@Summary" Disabled="@(publicationId==0)" OnConfirm="Generate" /></div></div>
</section>@if(pdfPath is not null){<section class="panel report-download-card"><div class="report-download-step"><span>2</span><div><p class="eyebrow">BAIXAR PDF</p><h2>Seu relatório está pronto</h2><p>O arquivo foi gerado com sucesso. Baixe o PDF para salvar, compartilhar ou imprimir.</p></div></div><a class="report-download-button" href="@($"/download/theme-report?path={Uri.EscapeDataString(pdfPath)}")"><AppIcon Name="download" Size="md" /><span>Baixar PDF gerado</span><small>Arquivo pronto para download</small></a></section>}</div>
@code {
    ReportsOverview? stats;
    IReadOnlyList<Theme> themes = [];
    IReadOnlyList<Publication> publications=[];
    long themeId;
    long publicationId;
    string? pdfPath, error, note;
    Publication? SelectedPublication => publications.FirstOrDefault(x=>x.Id==publicationId);
    string Summary => $"Publicação: {publications.FirstOrDefault(x=>x.Id==publicationId)?.Name??"não selecionada"} | Tema: {(themeId == 0 ? "Todos" : themes.FirstOrDefault(x => x.Id == themeId)?.Name)}";
    protected override async Task OnInitializedAsync()
    {
        stats = await ReportService.GetOverviewAsync();
        publications=await Publications.GetAllAsync();
    }
    async Task PublicationChanged()
    {
        themeId=0;
        pdfPath=null;
        themes=publicationId==0?[]:await Publications.GetLinkedThemesAsync(publicationId);
    }
    async Task Generate()
    {
        try
        {
            error = null;
            pdfPath = null;
            note = null;
            if(publicationId==0)throw new InvalidOperationException("Selecione a publicação para gerar o relatório.");
            var report = await ReportService.BuildThemesAsync(new(themeId == 0 ? null : themeId,publicationId));
            pdfPath = await Pdf.CreateThemeVersePdfAsync(report);
            note = $"Relatório gerado com {report.ThemeCount} tema(s) e {report.ReferenceCount} referência(s).";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao gerar relatório para o tema {ThemeId}.", themeId);
            error = ex.Message;
        }
    }
}
