@page "/temas/vincular-versiculos"
@rendermode InteractiveServer
@inject Biblia.Application.Interfaces.IThemeService Themes
@inject Biblia.Application.Interfaces.IThemeVerseLinkService Links
@inject Biblia.Application.Interfaces.IBibleVersionManager Versions
@inject Biblia.Application.Interfaces.IBibleRepository Bible
@inject Biblia.Application.Interfaces.IBibleSearchService SearchService
@inject Biblia.Application.Interfaces.IPublicationService Publications
<PageTitle>Vincular versículos — BíbliaTema</PageTitle>
<div class="theme-linker-page">
<PageHeader Title="Vincular versículos" Eyebrow="" Subtitle="Escolha um tema e selecione um ou vários versículos." />
@if(error is not null){<div class="notice error" role="alert">@error</div>}@if(note is not null){<div class="notice success" role="status">@note</div>}
<section class="panel linker-reference"><div class="linker-reference-heading"><h2>Referência</h2><label>Publicação / PDF *<select value="@publicationId" @onchange="PublicationChanged"><option value="0">Selecione</option>@foreach(var p in publications){<option value="@p.Id">@p.Name</option>}</select></label></div><div class="linker-reference-fields">
 <label>Tema<select value="@themeId" @onchange="ThemeChanged"><option value="0">Selecione</option>@foreach(var t in themes){<option value="@t.Id">@t.Name</option>}</select></label><label>Versão<select value="@versionCode" @onchange="VersionChanged">@foreach(var v in versions){<option value="@v.Code">@v.DisplayName (@v.Code)</option>}</select></label>
 <label>Livro<select value="@bookId" @onchange="BookChanged"><option value="0">Selecione</option>@foreach(var b in books){<option value="@b.BookReferenceId">@b.Name</option>}</select></label>
 <label>Capítulo<select value="@chapter" @onchange="ChapterChanged"><option value="0">Selecione</option>@foreach(var c in chapters){<option value="@c">@c</option>}</select></label>
</div></section>
<div class="primary-action-bar"><span><strong>@selected.Count</strong> versículo(s) selecionado(s) @if(themeId==0&&selected.Count>0){<small class="muted">— selecione o tema de destino</small>}</span><div class="toolbar theme-linker-content-actions" aria-label="Ações do tema">@if(themeId==0){<button type="button" class="btn primary" disabled="@(selected.Count==0)" @onclick="ShowThemeRequired">Salvar vinculação</button>}else{<ConfirmButton Label="Salvar vinculação" Title="Confirmar vinculação" Message="Deseja vincular os versículos selecionados ao tema?" Summary="@Summary" Disabled="@(selected.Count==0)" OnConfirm="LinkSelected" />}<button type="button" class="btn btn-action" disabled="@(themeId==0)" @onclick="OpenTextBlock"><AppIcon Name="add" /> Adicionar bloco de texto</button><a class="btn theme-linker-view-action" href="#conteudo-do-tema"><AppIcon Name="book" /> Ver versículos e blocos</a></div></div>
@if(themeId==0){<p class="muted">Selecione um tema para adicionar blocos de texto. Não é necessário selecionar livro, capítulo ou versículos.</p>}
@if(chapterVerses.Count>0){<section class="panel"><div class="selection-toolbar"><h2>Versículos do capítulo</h2><span><strong>@selected.Count</strong> selecionado(s)</span></div><div class="verse-picker">
@foreach(var verse in chapterVerses){var key=Key(verse);var isLinked=IsLinked(verse);var chosen=selected.ContainsKey(key);<article class="search-result @(isLinked?"already-linked":"")"><input type="checkbox" disabled="@isLinked" checked="@chosen" aria-label="Selecionar versículo @verse.Verse" @onchange="e=>Toggle(verse,IsChecked(e.Value))"/><div><strong>@BookName @chapter:@verse.Verse</strong> @if(isLinked){<span class="badge linked">Já vinculado</span>}<p>@verse.Text</p>@if(chosen){<label class="field">Observação deste vínculo<textarea maxlength="2000" rows="2" value="@selected[key].Observation" @oninput="e=>Observation(key,e.Value?.ToString())"></textarea></label>}</div></article>}
</div></section>}
<section class="panel theme-bible-search"><div class="theme-bible-search-bar"><h2>Pesquisar em toda a Bíblia</h2><div class="form-grid"><input aria-label="Termo de pesquisa" maxlength="100" placeholder="Digite uma palavra ou expressão" @bind="searchTerm" @onkeydown="SearchKeyDown" /><button type="button" class="btn primary" @onclick="SearchBible">Pesquisar</button></div></div>
@if(searchResults.Count>0){<div class="selection-toolbar"><strong>@searchResults.Count resultado(s) nesta página</strong><span>@selected.Count selecionado(s) no total</span></div><div class="search-results">@foreach(var verse in searchResults){var key=Key(verse);var isLinked=IsLinked(verse);var chosen=selected.ContainsKey(key);<article class="search-result @(isLinked?"already-linked":"")"><input type="checkbox" disabled="@isLinked" checked="@chosen" aria-label="Selecionar @verse.BookName @verse.Chapter:@verse.Verse" @onchange="e=>Toggle(verse,IsChecked(e.Value))"/><div><strong>@verse.BookName @verse.Chapter:@verse.Verse</strong> <span class="badge">@verse.VersionCode</span> @if(isLinked){<span class="badge linked">Já vinculado</span>}<p>@verse.Text</p>@if(chosen){<label class="field">Observação deste vínculo<textarea maxlength="2000" rows="2" value="@selected[key].Observation" @oninput="e=>Observation(key,e.Value?.ToString())"></textarea></label>}</div></article>}</div><div class="pagination"><button type="button" class="btn secondary" disabled="@(searchPage==1)" @onclick="PreviousSearch"><AppIcon Name="back" Size="sm" /> Anterior</button><span>Página @searchPage</span><button type="button" class="btn secondary" disabled="@(searchResults.Count<SearchPageSize)" @onclick="NextSearch">Próxima <AppIcon Name="next" Size="sm" /></button></div>}</section>
<section class="panel" id="conteudo-do-tema"><h2>Versículos já vinculados</h2><p class="muted">Versículos e blocos de texto do tema, na mesma sequência usada no PDF.</p><ThemeContentEditor @key="themeId" @ref="contentEditor" ThemeId="@themeId" Linked="@linked" Drafts="@drafts" SaveObservation="SaveObservation" RemoveLink="Unlink" /></section>
</div>
@code{
 [SupplyParameterFromQuery(Name="themeId")] public long? RequestedThemeId{get;set;}
 ThemeContentEditor? contentEditor;
 long? appliedThemeId;
 protected override async Task OnParametersSetAsync(){if(RequestedThemeId!=appliedThemeId){appliedThemeId=RequestedThemeId;if(RequestedThemeId is >0&&themes.Any(t=>t.Id==RequestedThemeId)){themeId=RequestedThemeId.Value;selected.Clear();await LoadLinked();}}}
 Task OpenTextBlock()=>publicationId==0?Task.CompletedTask:contentEditor?.OpenNewBlockAsync()??Task.CompletedTask;
 const int SearchPageSize=30;IReadOnlyList<Theme> themes=[];IReadOnlyList<Publication> publications=[];IReadOnlyList<BibleVersionCatalogEntry> versions=[];IReadOnlyList<BibleBook> books=[];IReadOnlyList<int> chapters=[];IReadOnlyList<BibleVerse> chapterVerses=[],searchResults=[];IReadOnlyList<ThemeVerseLinkDisplay> linked=[];readonly Dictionary<string,VerseSelection> selected=[];readonly HashSet<int> linkedVerses=[];readonly Dictionary<long,string> drafts=[];long themeId,publicationId;string versionCode="",searchTerm="";int bookId,chapter,searchPage=1;string? error,note;string BookName=>books.FirstOrDefault(x=>x.BookReferenceId==bookId)?.Name??"Livro";string Summary=>$"Publicação: {publications.FirstOrDefault(x=>x.Id==publicationId)?.Name??"não selecionada"} | Tema: {themes.FirstOrDefault(x=>x.Id==themeId)?.Name??"não selecionado"} | Versão: {versionCode} | Versículos: {selected.Count}";
 protected override async Task OnInitializedAsync(){themes=await Themes.SearchAsync(null);publications=await Publications.GetAllAsync();versions=(await Versions.GetVersionsAsync()).Where(x=>x.IsInstalled&&x.IsEnabled&&x.ValidationStatus!=BibleVersionValidationStatus.Incompatible).ToArray();versionCode=(await Versions.GetActiveVersionAsync())?.Code??versions.FirstOrDefault()?.Code??"";await LoadBooks();}
 async Task PublicationChanged(ChangeEventArgs e){publicationId=long.TryParse(e.Value?.ToString(),out var x)?x:0;selected.Clear();await LoadLinked();}
 async Task ThemeChanged(ChangeEventArgs e){themeId=long.TryParse(e.Value?.ToString(),out var x)?x:0;selected.Clear();await LoadLinked();}
 async Task VersionChanged(ChangeEventArgs e){versionCode=e.Value?.ToString()??"";bookId=chapter=0;chapters=[];chapterVerses=[];searchResults=[];searchPage=1;selected.Clear();await LoadBooks();await LoadLinked();}
 async Task LoadBooks()=>books=string.IsNullOrWhiteSpace(versionCode)?[]:await Bible.GetBooksAsync(versionCode);
 async Task BookChanged(ChangeEventArgs e){bookId=int.TryParse(e.Value?.ToString(),out var x)?x:0;chapter=0;chapterVerses=[];selected.Clear();chapters=bookId==0?[]:await Bible.GetChaptersAsync(versionCode,bookId);}
 async Task ChapterChanged(ChangeEventArgs e){chapter=int.TryParse(e.Value?.ToString(),out var x)?x:0;selected.Clear();chapterVerses=chapter==0?[]:await Bible.GetVersesAsync(versionCode,bookId,chapter);RefreshLinkedVerses();}
 static bool IsChecked(object? value)=>value is bool isChecked?isChecked:bool.TryParse(value?.ToString(),out var parsed)&&parsed;
 void Toggle(BibleVerse v,bool isChecked){var key=Key(v);if(isChecked&&!IsLinked(v))selected[key]=new(v.BookReferenceId,v.Chapter,v.Verse,v.Verse);else selected.Remove(key);}
 void ShowThemeRequired(){note=null;error="Selecione o tema de destino antes de salvar a vinculação.";}
 void Observation(string key,string? value){if(selected.TryGetValue(key,out var current))selected[key]=current with{Observation=value};}
 async Task SearchKeyDown(KeyboardEventArgs e){if(e.Key=="Enter")await SearchBible();}
 async Task SearchBible(){try{error=null;note=null;var term=searchTerm.Trim();if(term.Length<2)throw new InvalidOperationException("Digite ao menos dois caracteres para pesquisar.");var result=await SearchService.SearchAsync(new(term,[versionCode],null,null,(searchPage-1)*SearchPageSize,SearchPageSize));searchResults=result.Items;if(searchResults.Count==0)note="Nenhum versículo encontrado para o termo informado.";}catch(Exception ex){error=ex.Message;searchResults=[];}}
 async Task PreviousSearch(){if(searchPage>1){searchPage--;await SearchBible();}}
 async Task NextSearch(){searchPage++;await SearchBible();}
 bool IsLinked(BibleVerse verse)=>linked.Any(x=>x.BookReferenceId==verse.BookReferenceId&&x.Chapter==verse.Chapter&&verse.Verse>=x.Verse&&verse.Verse<=x.VerseEnd);
 static string Key(BibleVerse verse)=>$"{verse.BookReferenceId}:{verse.Chapter}:{verse.Verse}";
 async Task LinkSelected(){try{error=null;if(publicationId==0)throw new InvalidOperationException("Selecione a publicação de destino.");if(themeId==0)throw new InvalidOperationException("Selecione o tema de destino.");if(selected.Count==0)throw new InvalidOperationException("Selecione ao menos um versículo.");var result=await Links.LinkToPublicationAsync(publicationId,themeId,versionCode,selected.Values.ToArray(),false);note=$"Vinculação concluída: {result.LinksCreated} novo(s), {result.AlreadyLinked} já existente(s).";selected.Clear();await LoadLinked();}catch(Exception ex){error=ex.Message;}}
 async Task LoadLinked(){linked=[];drafts.Clear();if(themeId==0||publicationId==0||string.IsNullOrWhiteSpace(versionCode)){linkedVerses.Clear();return;}try{var ids=(await Publications.GetContentAsync(publicationId,themeId)).Where(x=>x.ReferenceId is not null).Select(x=>x.ReferenceId!.Value).ToHashSet();linked=(await Links.GetLinkedAsync(themeId,versionCode)).Where(x=>ids.Contains(x.ReferenceId)).DistinctBy(x=>x.ReferenceId).OrderBy(x=>Biblia.Domain.Rules.BibleCanonicalOrder.Key(x)).ToArray();foreach(var x in linked)drafts[x.ReferenceId]=x.Observation??"";RefreshLinkedVerses();}catch(Exception ex){error=ex.Message;}}
 void RefreshLinkedVerses(){linkedVerses.Clear();foreach(var x in linked.Where(x=>x.BookReferenceId==bookId&&x.Chapter==chapter))linkedVerses.Add(x.Verse);}
 async Task SaveObservation(ThemeVerseLinkDisplay item){try{await Links.UpdateObservationAsync(themeId,item.ReferenceId,drafts.GetValueOrDefault(item.ReferenceId));note=$"Observação de {item.FormattedReference} salva com sucesso.";await LoadLinked();}catch(Exception ex){error=ex.Message;}}
 async Task Unlink(ThemeVerseLinkDisplay item){try{await Links.UnlinkFromPublicationAsync(publicationId,themeId,item.ReferenceId);note=$"{item.FormattedReference} foi removido desta publicação; tema e referência foram preservados.";await LoadLinked();}catch(Exception ex){error=ex.Message;}}
}
