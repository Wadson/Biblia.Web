@page "/temas/vincular-versiculos"
@rendermode InteractiveServer
@inject Biblia.Application.Interfaces.IThemeService Themes
@inject Biblia.Application.Interfaces.IThemeVerseLinkService Links
@inject Biblia.Application.Interfaces.IBibleVersionManager Versions
@inject Biblia.Application.Interfaces.IBibleRepository Bible
@inject Biblia.Application.Interfaces.IPublicationService Publications
@inject IJSRuntime JS
<PageTitle>Vincular versículos — BíbliaTema</PageTitle>
<div class="theme-linker-page">
<PageHeader Title="Vincular versículos" Eyebrow="" Subtitle="Escolha um tema e selecione um ou vários versículos." />
@if(error is not null){<div class="notice error" role="alert">@error</div>}@if(note is not null){<div class="notice success" role="status">@note</div>}
<section class="panel linker-step destination-step"><div class="step-heading"><span class="step-number">1</span><div><p class="eyebrow">DESTINO</p><div class="step-title-line"><h2>Selecione a publicação e o tema</h2><p>Defina onde os versículos e blocos serão incluídos.</p></div></div></div><div class="destination-fields"><label>Publicação / PDF *<select value="@publicationId" @onchange="PublicationChanged"><option value="0">Selecione</option>@foreach(var p in publications){<option value="@p.Id">@p.Name</option>}</select></label>
 <div class="theme-picker"><span class="theme-picker-label">Tema *</span><button type="button" class="theme-picker-trigger" disabled="@(publicationId==0)" @onclick="ToggleThemePicker" aria-haspopup="listbox" aria-expanded="@themePickerOpen"><span class="theme-swatch" style="background:@(SelectedTheme?.ColorHex ?? "transparent")"></span><span>@(SelectedTheme?.Name ?? "Selecione")</span><span class="theme-picker-arrow" aria-hidden="true">⌄</span></button>@if(themePickerOpen){<div class="theme-picker-options" role="listbox" aria-label="Temas">@foreach(var t in themes){<button type="button" class="theme-picker-option @(t.Id==themeId?"selected":"")" role="option" aria-selected="@(t.Id==themeId)" @onclick="()=>SelectTheme(t)"><span class="theme-swatch" style="background:@(t.ColorHex ?? "transparent")"></span><span>@t.Name</span></button>}</div>}</div></div></section>
<section id="encontre-versiculos" class="panel linker-step selection-step @(DestinationReady?"":"is-locked")"><div class="step-heading"><span class="step-number">2</span><div><p class="eyebrow">SELEÇÃO</p><div class="step-title-line"><h2><AppIcon Name="book" /> Encontre e selecione versículos</h2><p>@(DestinationReady?"Escolha versão, livro e capítulo para visualizar os versículos.":"Selecione uma publicação e um tema para continuar.")</p></div></div></div><fieldset disabled="@(!DestinationReady)"><div class="linker-reference-fields">
 <label>Versão<select value="@versionCode" @onchange="VersionChanged"><option value="">Selecione</option>@foreach(var v in versions){<option value="@v.Code">@v.DisplayName (@v.Code)</option>}</select></label>
 <label>Livro<select value="@bookId" @onchange="BookChanged"><option value="0">Selecione</option>@foreach(var b in books){<option value="@b.BookReferenceId">@b.Name</option>}</select></label>
 <label>Capítulo<select value="@chapter" @onchange="ChapterChanged"><option value="0">Selecione</option>@foreach(var c in chapters){<option value="@c">@c</option>}</select></label>
</div></fieldset></section>
<div class="primary-action-bar"><span><strong>@selected.Count</strong> versículo(s) selecionado(s) @if(!DestinationReady&&selected.Count>0){<small class="muted">— selecione o destino</small>}</span><div class="toolbar theme-linker-content-actions" aria-label="Ações do tema"><a class="btn secondary linker-bible-shortcut" href="#encontre-versiculos" @onclick="GoToBibleSelection" @onclick:preventDefault="true"><AppIcon Name="book" /> Bíblia</a>@if(themeId==0){<button type="button" class="btn primary" disabled="@(selected.Count==0)" @onclick="ShowThemeRequired">Salvar vinculação</button>}else{<ConfirmButton Label="Salvar vinculação" Title="Confirmar vinculação" Message="Deseja vincular os versículos selecionados ao tema?" Summary="@Summary" Disabled="@(selected.Count==0||!DestinationReady)" OnConfirm="LinkSelected" />}<button type="button" class="btn btn-action" disabled="@(!DestinationReady)" @onclick="OpenTextBlock"><AppIcon Name="add" /> Adicionar bloco de texto</button></div></div>
@if(themeId==0){<p class="muted">Selecione um tema para adicionar blocos de texto. Não é necessário selecionar livro, capítulo ou versículos.</p>}
@if(chapterVerses.Count>0){<section class="panel verse-selection-panel"><div class="selection-toolbar"><h2>Versículos do capítulo</h2><span><strong>@selected.Count</strong> selecionado(s)</span><div class="linker-font-controls" aria-label="Tamanho da fonte"><button type="button" class="btn secondary" @onclick="DecreaseVerseFont">−A</button><button type="button" class="btn secondary" @onclick="IncreaseVerseFont">+A</button></div></div><div class="verse-picker" style="@($"--linker-verse-font-size:{verseFontSize}px")">
@foreach(var verse in chapterVerses){var key=Key(verse);var isLinked=IsLinked(verse);var chosen=selected.ContainsKey(key);<article @key="key" class="search-result @(isLinked?"already-linked":"")"><input type="checkbox" disabled="@isLinked" checked="@chosen" aria-label="Selecionar versículo @verse.Verse" @onchange="e=>Toggle(verse,IsChecked(e.Value))"/><div><strong>@BookName @chapter:@verse.Verse</strong> @if(isLinked){<span class="badge linked">Já vinculado</span>}<p class="linker-verse-text">@verse.Text</p>@if(chosen){<label class="field">Observação deste vínculo<textarea @key="key" id="@($"selection-observation-{key}")" name="@($"selection-observation-{key}")" autocomplete="off" maxlength="2000" rows="2" value="@selected[key].Observation" @oninput="e=>Observation(key,e.Value?.ToString())"></textarea></label>}</div></article>}
</div></section>}
<section class="panel linked-content-panel" id="conteudo-do-tema"><div class="step-heading"><span class="step-number">3</span><div><p class="eyebrow">CONTEÚDO</p><div class="step-title-line"><h2>Versículos e blocos já vinculados</h2><p>Organize a sequência que será usada no PDF.</p></div></div></div>@if(DestinationReady){<ThemeContentEditor @key="(publicationId,themeId)" @ref="contentEditor" ThemeId="@themeId" PublicationId="@publicationId" Linked="@linked" SaveObservation="SaveObservation" RemoveLink="Unlink" />}else{<p class="muted">Selecione a publicação e o tema para gerenciar o conteúdo vinculado.</p>}</section>
</div>
@code{
 [SupplyParameterFromQuery(Name="themeId")] public long? RequestedThemeId{get;set;}
 ThemeContentEditor? contentEditor;
 long? appliedThemeId;
 protected override async Task OnParametersSetAsync(){if(RequestedThemeId!=appliedThemeId){appliedThemeId=RequestedThemeId;if(RequestedThemeId is >0&&themes.Any(t=>t.Id==RequestedThemeId)){themeId=RequestedThemeId.Value;selected.Clear();await LoadLinked();}}}
 Task OpenTextBlock()=>publicationId==0?Task.CompletedTask:contentEditor?.OpenNewBlockAsync()??Task.CompletedTask;
 Task GoToBibleSelection()=>JS.InvokeVoidAsync("bibliaTema.scrollToLinkerSelection").AsTask();
 IReadOnlyList<Theme> themes=[];IReadOnlyList<Publication> publications=[];IReadOnlyList<BibleVersionCatalogEntry> versions=[];IReadOnlyList<BibleBook> books=[];IReadOnlyList<int> chapters=[];IReadOnlyList<BibleVerse> chapterVerses=[];IReadOnlyList<ThemeVerseLinkDisplay> linked=[];readonly Dictionary<string,VerseSelection> selected=[];readonly HashSet<string> editedSelectionObservations=[];readonly HashSet<int> linkedVerses=[];long themeId,publicationId;bool themePickerOpen;string versionCode="";int bookId,chapter,verseFontSize=17;string? error,note;bool DestinationReady=>publicationId>0&&themeId>0;Theme? SelectedTheme=>themes.FirstOrDefault(x=>x.Id==themeId);string BookName=>books.FirstOrDefault(x=>x.BookReferenceId==bookId)?.Name??"Livro";string Summary=>$"Publicação: {publications.FirstOrDefault(x=>x.Id==publicationId)?.Name??"não selecionada"} | Tema: {themes.FirstOrDefault(x=>x.Id==themeId)?.Name??"não selecionado"} | Versão: {versionCode} | Versículos: {selected.Count}";
 protected override async Task OnInitializedAsync(){publications=await Publications.GetAllAsync();versions=(await Versions.GetVersionsAsync()).Where(x=>x.IsInstalled&&x.IsEnabled&&x.ValidationStatus!=BibleVersionValidationStatus.Incompatible).ToArray();versionCode=(await Versions.GetActiveVersionAsync())?.Code??versions.FirstOrDefault()?.Code??"";await LoadBooks();}
 async Task PublicationChanged(ChangeEventArgs e){publicationId=long.TryParse(e.Value?.ToString(),out var x)?x:0;ClearSelections();linked=[];linkedVerses.Clear();themeId=0;themePickerOpen=false;if(publicationId==0){themes=[];versionCode="";bookId=chapter=0;books=[];chapters=[];chapterVerses=[];}else{themes=await Publications.GetLinkedThemesAsync(publicationId);}await LoadLinked();}
 async Task ThemeChanged(ChangeEventArgs e){themeId=long.TryParse(e.Value?.ToString(),out var x)?x:0;ClearSelections();linked=[];linkedVerses.Clear();await LoadLinked();}
 void ToggleThemePicker()=>themePickerOpen=!themePickerOpen;
 async Task SelectTheme(Theme theme){themeId=theme.Id;themePickerOpen=false;ClearSelections();linked=[];linkedVerses.Clear();await LoadLinked();}
 async Task VersionChanged(ChangeEventArgs e){versionCode=e.Value?.ToString()??"";bookId=chapter=0;chapters=[];chapterVerses=[];selected.Clear();await LoadBooks();await LoadLinked();}
 async Task LoadBooks()=>books=string.IsNullOrWhiteSpace(versionCode)?[]:await Bible.GetBooksAsync(versionCode);
 async Task BookChanged(ChangeEventArgs e){bookId=int.TryParse(e.Value?.ToString(),out var x)?x:0;chapter=0;chapterVerses=[];selected.Clear();chapters=bookId==0?[]:await Bible.GetChaptersAsync(versionCode,bookId);}
 async Task ChapterChanged(ChangeEventArgs e){chapter=int.TryParse(e.Value?.ToString(),out var x)?x:0;selected.Clear();chapterVerses=chapter==0?[]:await Bible.GetVersesAsync(versionCode,bookId,chapter);RefreshLinkedVerses();}
 void DecreaseVerseFont()=>verseFontSize=Math.Max(13,verseFontSize-1);void IncreaseVerseFont()=>verseFontSize=Math.Min(28,verseFontSize+1);
 static bool IsChecked(object? value)=>value is bool isChecked?isChecked:bool.TryParse(value?.ToString(),out var parsed)&&parsed;
 void Toggle(BibleVerse v,bool isChecked){var key=Key(v);if(isChecked&&!IsLinked(v))selected[key]=new(v.BookReferenceId,v.Chapter,v.Verse,v.Verse);else{selected.Remove(key);editedSelectionObservations.Remove(key);}}
 void ShowThemeRequired(){note=null;error="Selecione o tema de destino antes de salvar a vinculação.";}
 void Observation(string key,string? value){if(selected.TryGetValue(key,out var current)){editedSelectionObservations.Add(key);selected[key]=current with{Observation=value};}}
 bool IsLinked(BibleVerse verse)=>linked.Any(x=>x.BookReferenceId==verse.BookReferenceId&&x.Chapter==verse.Chapter&&verse.Verse>=x.Verse&&verse.Verse<=x.VerseEnd);
 static string Key(BibleVerse verse)=>$"{verse.BookReferenceId}:{verse.Chapter}:{verse.Verse}";
 async Task LinkSelected(){try{error=null;if(publicationId==0)throw new InvalidOperationException("Selecione a publicação de destino.");if(themeId==0)throw new InvalidOperationException("Selecione o tema de destino.");if(selected.Count==0)throw new InvalidOperationException("Selecione ao menos um versículo.");var selections=selected.Select(pair=>editedSelectionObservations.Contains(pair.Key)?pair.Value:pair.Value with{Observation=null}).ToArray();var result=await Links.LinkToPublicationAsync(publicationId,themeId,versionCode,selections,false);note=$"Vinculação concluída: {result.LinksCreated} novo(s), {result.AlreadyLinked} já existente(s).";ClearSelections();await LoadLinked();}catch(Exception ex){error=ex.Message;}}
 void ClearSelections(){selected.Clear();editedSelectionObservations.Clear();}
 async Task LoadLinked(){linked=[];if(themeId==0||publicationId==0||string.IsNullOrWhiteSpace(versionCode)){linkedVerses.Clear();return;}try{linked=await Links.GetPublicationLinkedAsync(publicationId,themeId,versionCode);RefreshLinkedVerses();}catch(Exception ex){error=ex.Message;}}
 void RefreshLinkedVerses(){linkedVerses.Clear();foreach(var x in linked.Where(x=>x.BookReferenceId==bookId&&x.Chapter==chapter))linkedVerses.Add(x.Verse);}
 async Task SaveObservation(ThemeVerseLinkDisplay item){try{await Links.UpdatePublicationObservationAsync(publicationId,themeId,item.ReferenceId,item.Observation);note=$"Observação de {item.FormattedReference} salva com sucesso.";await LoadLinked();}catch(Exception ex){error=ex.Message;}}
 async Task Unlink(ThemeVerseLinkDisplay item){try{await Links.UnlinkFromPublicationAsync(publicationId,themeId,item.ReferenceId);note=$"{item.FormattedReference} foi removido desta publicação; tema e referência foram preservados.";await LoadLinked();}catch(Exception ex){error=ex.Message;}}
}
