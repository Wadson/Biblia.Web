@page "/pesquisar-biblia"
@rendermode InteractiveServer
@inject Biblia.Application.Interfaces.IBibleSearchService SearchService
@inject Biblia.Application.Interfaces.IBibleVersionManager Versions
<PageTitle>Pesquisar — BíbliaTema</PageTitle><PageHeader Title="Pesquisar na Bíblia" Eyebrow="BÍBLIA" />
<div class="panel bible-search-panel"><div class="form-grid"><label>Texto<input @bind="query" @bind:event="oninput" placeholder="Digite uma palavra ou expressão" @onkeydown="SearchKeyDown" /></label><label>Versão<select @bind="version"><option value="@AllVersions">Todas as versões instaladas</option>@foreach(var v in versions){<option value="@v.Code">@v.DisplayName (@v.Code)</option>}</select></label><button class="btn primary" @onclick="Search"><AppIcon Name="search" Size="sm" /> Pesquisar</button></div><p class="muted">Selecione todas as versões para comparar resultados ou escolha uma versão específica.</p></div>
@if(message is not null){<div class="notice" role="status">@message</div>}
@if(result is not null){<div class="selection-toolbar search-summary"><p class="muted"><strong>@result.TotalReturned</strong> resultado(s) em @result.Elapsed.TotalMilliseconds.ToString("0") ms</p><span class="badge">@(version==AllVersions?"Todas as versões":version)</span></div><div class="vertical-search-results">@foreach(var item in result.Items){<article class="card"><strong>@item.BookName @item.Chapter:@item.Verse</strong><p>@item.Text</p><span class="badge">@item.VersionCode</span></article>}</div>}
@code{
 const string AllVersions="__all";string query="",version=AllVersions;string? message;IReadOnlyList<BibleVersionCatalogEntry> versions=[];BibleSearchResult? result;
 protected override async Task OnInitializedAsync()=>versions=(await Versions.GetVersionsAsync()).Where(x=>x.IsInstalled&&x.IsEnabled&&x.ValidationStatus!=BibleVersionValidationStatus.Incompatible).ToArray();
 async Task Search(){var term=query.Trim();if(term.Length<2){message="Digite pelo menos 2 caracteres para pesquisar.";result=null;return;}var selected=version==AllVersions?versions.Select(x=>x.Code).ToArray():[version];if(selected.Length==0){message="Não há versões bíblicas instaladas e ativas para pesquisar.";result=null;return;}message=null;result=await SearchService.SearchAsync(new(term,selected,null,null,0,300));}
 async Task SearchKeyDown(KeyboardEventArgs e){if(e.Key=="Enter")await Search();}
}
