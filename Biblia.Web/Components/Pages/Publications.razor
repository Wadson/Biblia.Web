@page "/publicacoes"
@rendermode InteractiveServer
@inject Biblia.Application.Interfaces.IPublicationService Service
<PageTitle>Publicações — BíbliaTema</PageTitle><PageHeader Title="Publicações" Eyebrow="PDF" />
@if(error is not null){<div class="notice error">@error</div>}@if(note is not null){<div class="notice success">@note</div>}
<section @ref="editorSection" tabindex="-1" class="panel publication-section publication-info"><div class="publication-step-heading"><span>1</span><div><p class="eyebrow">INFORMAÇÕES DA PUBLICAÇÃO</p><div class="publication-step-title"><h2>Defina o conteúdo do título</h2><p>Informe os textos que aparecerão no cabeçalho do livro.</p></div></div></div><div class="publication-grid"><label><span class="field-label">Título do PDF <b>(*)</b></span><input @bind="editing.Title" placeholder="Insira o título do livro..." /></label><label><span class="field-label">Subtítulo <em>(Opcional)</em></span><input @bind="editing.Subtitle" placeholder="Complemento do título..." /></label><label class="publication-full-width"><span class="field-label">Texto adicional <em>(Opcional)</em></span><input @bind="editing.HeaderText" placeholder="Observações, dedicatória ou notas..." /></label></div><div class="publication-form-actions">@if(editing.Id>0){<ConfirmButton Label="Salvar alterações" ConfirmLabel="Salvar" CssClass="btn btn-edit" ConfirmCssClass="btn btn-edit" Title="Confirmar alteração" Message="Deseja realmente salvar as alterações realizadas?" OnConfirm="Save" />}else{<button class="btn btn-save" @onclick="Save">Salvar publicação</button>}<button class="btn btn-action" @onclick="New">Nova publicação</button><button class="btn secondary" @onclick="Cancel">Cancelar</button></div></section>
<section class="panel header-settings"><div class="publication-step-heading"><span>2</span><div><p class="eyebrow">ESTILIZAÇÃO DO CABEÇALHO</p><div class="publication-step-title"><h2>Personalize a aparência</h2><p>Defina cores, tipografia e estilo da publicação.</p></div></div></div><header><h3>Tipografia do cabeçalho</h3><label>Fundo do cabeçalho <input type="color" @bind="editing.HeaderBackgroundColorHex" /></label></header><div class="header-style-row"><strong>Título</strong><label>Cor <input type="color" @bind="editing.TitleTextColorHex" /></label><label>Tamanho (px) <input type="number" min="8" max="72" @bind="editing.TitleFontSize" /></label><span class="inline-style">Estilo <button class="@(editing.TitleBold?"selected":"")" @onclick="()=>editing.TitleBold=!editing.TitleBold">B</button><button class="italic @(editing.TitleItalic?"selected":"")" @onclick="()=>editing.TitleItalic=!editing.TitleItalic">I</button></span><output style="color:@editing.TitleTextColorHex;font-size:@(editing.TitleFontSize??18)px;font-weight:@(editing.TitleBold?"700":"400");font-style:@(editing.TitleItalic?"italic":"normal")">Prévia do Título</output></div><div class="header-style-row"><strong>Nome da Igreja</strong><label>Cor <input type="color" @bind="editing.OrganizationTextColorHex" /></label><label>Tamanho (px) <input type="number" min="8" max="72" @bind="editing.OrganizationFontSize" /></label><span class="inline-style">Estilo <button disabled>B</button><button class="italic" disabled>I</button></span><output style="color:@editing.OrganizationTextColorHex;font-size:@(editing.OrganizationFontSize??11)px">Prévia do Nome da Igreja</output></div><div class="header-style-row"><strong>Texto Adicional</strong><label>Cor <input type="color" @bind="editing.HeaderDetailTextColorHex" /></label><label>Tamanho (px) <input type="number" min="8" max="72" @bind="editing.HeaderDetailFontSize" /></label><span class="inline-style">Estilo <button disabled>B</button><button class="italic" disabled>I</button></span><output style="color:@editing.HeaderDetailTextColorHex;font-size:@(editing.HeaderDetailFontSize??8)px">Prévia do Texto Adicional</output></div></section>
<section class="panel publication-section"><h2>Prévia imediata do cabeçalho</h2><div class="header-preview" style="background:@editing.HeaderBackgroundColorHex">@if(logoPreview is not null){<img src="@logoPreview" alt="Logomarca da igreja" />}<div><small style="color:@editing.OrganizationTextColorHex;font-size:@(editing.OrganizationFontSize??11)px">@branding?.Name</small><strong style="color:@editing.TitleTextColorHex;font-size:@(editing.TitleFontSize??18)px;font-weight:@(editing.TitleBold?"700":"400");font-style:@(editing.TitleItalic?"italic":"normal")">@(editing.Title??"Título da publicação")</strong><span style="color:@editing.SubtitleTextColorHex;font-size:@(editing.SubtitleFontSize??14)px">@editing.Subtitle</span><em style="color:@editing.HeaderDetailTextColorHex;font-size:@(editing.HeaderDetailFontSize??12)px">@editing.HeaderText</em></div></div></section><section class="panel publication-section publication-list-step"><div class="publication-step-heading"><span>4</span><div><p class="eyebrow">PUBLICAÇÕES CADASTRADAS</p><div class="publication-step-title"><h2>Gerencie os títulos</h2><p>Altere ou exclua rapidamente uma publicação já criada.</p></div></div></div>@foreach(var item in items){<div class="list-row publication-list-row"><strong class="publication-info">@(item.Title??item.Name)</strong><div class="publication-actions"><button class="btn btn-edit" @onclick="()=>EditAsync(item)">Alterar</button><ConfirmButton Label="Excluir" ConfirmLabel="Excluir" Title="Confirmar exclusão" Message="@($"Deseja realmente excluir \"{item.Title??item.Name}\"?")" Danger="true" CssClass="btn btn-delete" OnConfirm="()=>Delete(item.Id)" /></div></div>}</section>
@code { IReadOnlyList<Publication> items=[];OrganizationBranding? branding;Publication editing=Blank();ElementReference editorSection;string? logoPreview,error,note;static Publication Blank()=>new(0,"",null,null,null,"#0D3B66","#FFFFFF",18,false,false,null,DateTimeOffset.UtcNow,DateTimeOffset.UtcNow){TitleTextColorHex="#FFFFFF",OrganizationTextColorHex="#FFFFFF",OrganizationFontSize=11,SubtitleTextColorHex="#FFFFFF",SubtitleFontSize=9,HeaderDetailTextColorHex="#FFFFFF",HeaderDetailFontSize=8};protected override async Task OnInitializedAsync(){items=await Service.GetAllAsync();branding=await Service.GetBrandingAsync();logoPreview=branding?.Logo is {Length:>0} logo?$"data:{branding.LogoContentType??"image/png"};base64,{Convert.ToBase64String(logo)}":null;}void New()=>editing=Blank();void Clear(){New();note=null;error=null;}void Cancel()=>Clear();void Edit(Publication item){editing=item with{Title=item.Title??item.Name,HeaderBackgroundColorHex=item.HeaderBackgroundColorHex??"#0D3B66",TitleTextColorHex=item.TitleTextColorHex??item.HeaderTextColorHex??"#FFFFFF",OrganizationTextColorHex=item.OrganizationTextColorHex??item.HeaderTextColorHex??"#FFFFFF",SubtitleTextColorHex=item.SubtitleTextColorHex??item.HeaderTextColorHex??"#FFFFFF",HeaderDetailTextColorHex=item.HeaderDetailTextColorHex??item.HeaderTextColorHex??"#FFFFFF",TitleFontSize=item.TitleFontSize??18,OrganizationFontSize=item.OrganizationFontSize??11,SubtitleFontSize=item.SubtitleFontSize??9,HeaderDetailFontSize=item.HeaderDetailFontSize??8};}async Task EditAsync(Publication item){Edit(item);await InvokeAsync(StateHasChanged);await Task.Yield();await editorSection.FocusAsync();}async Task Save(){try{error=null;editing=editing with{Name=editing.Title??""};editing=await Service.SaveAsync(editing);items=await Service.GetAllAsync();note="Publicação salva.";}catch(Exception ex){error=ex.Message;}}async Task Delete(long id){await Service.DeleteAsync(id);items=await Service.GetAllAsync();New();} }
