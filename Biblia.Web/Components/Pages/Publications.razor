@page "/publicacoes"
@rendermode InteractiveServer
@inject Biblia.Application.Interfaces.IPublicationService Service
<PageTitle>Publicações — BíbliaTema</PageTitle><PageHeader Title="Publicações" Eyebrow="PDF" />
@if(error is not null){<div class="notice error">@error</div>}@if(note is not null){<div class="notice success">@note</div>}
<section class="panel publication-section publication-info"><h2>Informações da Publicação</h2><div class="publication-grid"><label>Nome <b>*</b><input @bind="editing.Name" placeholder="Insira o nome..." /></label><label>Título do PDF<input @bind="editing.Title" placeholder="Insira o título..." /></label><label>Subtítulo<input @bind="editing.Subtitle" /></label><label>Texto adicional<input @bind="editing.HeaderText" /></label></div></section>
<section class="panel header-settings"><p class="eyebrow">ESTILIZAÇÃO DO CABEÇALHO</p><header><h2>Tipografia do Cabeçalho</h2><label>Fundo do cabeçalho <input type="color" @bind="editing.HeaderBackgroundColorHex" /></label></header><div class="header-style-row"><strong>Título</strong><label>Cor <input type="color" @bind="editing.TitleTextColorHex" /></label><label>Tamanho (px) <input type="number" min="8" max="72" @bind="editing.TitleFontSize" /></label><span class="inline-style">Estilo <button class="@(editing.TitleBold?"selected":"")" @onclick="()=>editing.TitleBold=!editing.TitleBold">B</button><button class="italic @(editing.TitleItalic?"selected":"")" @onclick="()=>editing.TitleItalic=!editing.TitleItalic">I</button></span><output style="color:@editing.TitleTextColorHex;font-size:@(editing.TitleFontSize??18)px;font-weight:@(editing.TitleBold?"700":"400");font-style:@(editing.TitleItalic?"italic":"normal")">Prévia do Título</output></div><div class="header-style-row"><strong>Nome da Igreja</strong><label>Cor <input type="color" @bind="editing.OrganizationTextColorHex" /></label><label>Tamanho (px) <input type="number" min="8" max="72" @bind="editing.OrganizationFontSize" /></label><span class="inline-style">Estilo <button disabled>B</button><button class="italic" disabled>I</button></span><output style="color:@editing.OrganizationTextColorHex;font-size:@(editing.OrganizationFontSize??11)px">Prévia do Nome da Igreja</output></div><div class="header-style-row"><strong>Texto Adicional</strong><label>Cor <input type="color" @bind="editing.HeaderDetailTextColorHex" /></label><label>Tamanho (px) <input type="number" min="8" max="72" @bind="editing.HeaderDetailFontSize" /></label><span class="inline-style">Estilo <button disabled>B</button><button class="italic" disabled>I</button></span><output style="color:@editing.HeaderDetailTextColorHex;font-size:@(editing.HeaderDetailFontSize??8)px">Prévia do Texto Adicional</output></div><div class="logo-compact"><div><h3>Logomarca do cabeçalho</h3><p>A proporção é ajustada automaticamente no preview e no PDF.</p></div>@if(logoPreview is not null){<img src="@logoPreview" alt="Logomarca atual" />}<a class="btn secondary" href="/organizacao">Alterar logomarca</a><div class="logo-actions">@if(editing.Id>0){<ConfirmButton Label="Alterar" ConfirmLabel="Alterar" CssClass="btn btn-edit" ConfirmCssClass="btn btn-edit" Title="Confirmar alteração" Message="Deseja realmente salvar as alterações realizadas?" OnConfirm="Save" />}else{<button class="btn btn-save" @onclick="Save">Salvar</button>}<button class="btn btn-action" @onclick="New">Novo</button><button class="btn secondary" @onclick="Clear">Limpar</button></div></div></section>
<section class="panel publication-section"><h2>Prévia do cabeçalho</h2><div class="header-preview" style="background:@editing.HeaderBackgroundColorHex">@if(logoPreview is not null){<img src="@logoPreview" alt="Logomarca da igreja" />}<div><small style="color:@editing.OrganizationTextColorHex;font-size:@(editing.OrganizationFontSize??11)px">@branding?.Name</small><strong style="color:@editing.TitleTextColorHex;font-size:@(editing.TitleFontSize??18)px;font-weight:@(editing.TitleBold?"700":"400");font-style:@(editing.TitleItalic?"italic":"normal")">@(editing.Title??"Título da publicação")</strong><span style="color:@editing.SubtitleTextColorHex;font-size:@(editing.SubtitleFontSize??14)px">@editing.Subtitle</span><em style="color:@editing.HeaderDetailTextColorHex;font-size:@(editing.HeaderDetailFontSize??12)px">@editing.HeaderText</em></div></div></section><section class="panel"><h2>Publicações cadastradas</h2>@foreach(var item in items){<div class="list-row publication-list-row"><strong class="publication-info">@item.Name</strong><div class="publication-actions"><button class="btn btn-edit" @onclick="()=>Edit(item)">Alterar</button><ConfirmButton Label="Excluir" ConfirmLabel="Excluir" Title="Confirmar exclusão" Message="@($"Deseja realmente excluir \"{item.Name}\"?")" Danger="true" CssClass="btn btn-delete" OnConfirm="()=>Delete(item.Id)" /></div></div>}</section>
@code { IReadOnlyList<Publication> items=[];OrganizationBranding? branding;Publication editing=Blank();string? logoPreview,error,note;static Publication Blank()=>new(0,"",null,null,null,"#0D3B66","#FFFFFF",18,false,false,null,DateTimeOffset.UtcNow,DateTimeOffset.UtcNow){TitleTextColorHex="#FFFFFF",OrganizationTextColorHex="#FFFFFF",OrganizationFontSize=11,SubtitleTextColorHex="#FFFFFF",SubtitleFontSize=9,HeaderDetailTextColorHex="#FFFFFF",HeaderDetailFontSize=8};protected override async Task OnInitializedAsync(){items=await Service.GetAllAsync();branding=await Service.GetBrandingAsync();logoPreview=branding?.Logo is {Length:>0} logo?$"data:{branding.LogoContentType??"image/png"};base64,{Convert.ToBase64String(logo)}":null;}void New()=>editing=Blank();void Clear(){New();note=null;error=null;}void Edit(Publication item){editing=item with{HeaderBackgroundColorHex=item.HeaderBackgroundColorHex??"#0D3B66",TitleTextColorHex=item.TitleTextColorHex??item.HeaderTextColorHex??"#FFFFFF",OrganizationTextColorHex=item.OrganizationTextColorHex??item.HeaderTextColorHex??"#FFFFFF",SubtitleTextColorHex=item.SubtitleTextColorHex??item.HeaderTextColorHex??"#FFFFFF",HeaderDetailTextColorHex=item.HeaderDetailTextColorHex??item.HeaderTextColorHex??"#FFFFFF",TitleFontSize=item.TitleFontSize??18,OrganizationFontSize=item.OrganizationFontSize??11,SubtitleFontSize=item.SubtitleFontSize??9,HeaderDetailFontSize=item.HeaderDetailFontSize??8};}async Task Save(){try{error=null;editing=await Service.SaveAsync(editing);items=await Service.GetAllAsync();note="Publicação salva.";}catch(Exception ex){error=ex.Message;}}async Task Delete(long id){await Service.DeleteAsync(id);items=await Service.GetAllAsync();New();} }
