@page "/biblia"
@rendermode InteractiveServer
@inject Biblia.Application.Interfaces.IBibleVersionManager Versions
@inject Biblia.Application.Interfaces.IBibleRepository Bible
@inject Biblia.Application.Interfaces.ISavedReferenceService Saved
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components
<PageTitle>Ler Bíblia — BíbliaTema</PageTitle><PageHeader Title="Ler Bíblia" Eyebrow="BÍBLIA" />
<div class="panel"><div class="form-grid"><label>Versão<select @bind="version"><option value="">Selecione</option>@foreach(var v in versions){<option value="@v.Code">@v.Code — @v.DisplayName</option>}</select></label><label>Livro<select @bind="bookId"><option value="0">Selecione</option>@foreach(var b in books){<option value="@b.BookReferenceId">@b.Name</option>}</select></label><label>Capítulo<input type="number" min="1" @bind="chapter" /></label><button class="btn primary" @onclick="(()=>Load())">Abrir</button></div></div>
@if(!string.IsNullOrEmpty(message)){<div class="notice">@message</div>}
@if(verses.Count>0){<div class="toolbar"><button class="btn secondary" @onclick="Previous"><AppIcon Name="back" Size="sm" /> Anterior</button><strong>@books.First(x=>x.BookReferenceId==bookId).Name @chapter</strong><button class="btn secondary" @onclick="Next">Próximo <AppIcon Name="next" Size="sm" /></button>@if(start>0){<button class="btn secondary" @onclick="Copy">Copiar seleção</button><ConfirmButton Label="Guardar referência" Title="Confirmar referência" Message="Deseja guardar esta referência?" Summary="@SelectionLabel" OnConfirm="Save" />}</div><section class="panel">@foreach(var v in verses){<div id="verse-@v.Verse" class="verse @(Selected(v.Verse)?"selected":"")" role="button" tabindex="0" @onclick="()=>Select(v.Verse)"><span class="verse-num">@v.Verse</span><span>@v.Text</span></div>}</section>}
@code{[SupplyParameterFromQuery(Name="version")]public string? RequestedVersion{get;set;}[SupplyParameterFromQuery(Name="book")]public int? RequestedBook{get;set;}[SupplyParameterFromQuery(Name="chapter")]public int? RequestedChapter{get;set;}[SupplyParameterFromQuery(Name="verse")]public int? RequestedVerse{get;set;}IReadOnlyList<BibleVersionCatalogEntry> versions=[];IReadOnlyList<BibleBook> books=[];IReadOnlyList<BibleVerse> verses=[];string version="";int bookId;int chapter=1,start,end;int? pendingScrollVerse;string? message;string SelectionLabel=>start==end?$"{chapter}:{start}":$"{chapter}:{start}-{end}";protected override async Task OnParametersSetAsync(){versions=(await Versions.GetVersionsAsync()).Where(x=>x.IsInstalled&&x.IsEnabled).ToArray();version=versions.FirstOrDefault(x=>x.Code.Equals(RequestedVersion,StringComparison.OrdinalIgnoreCase))?.Code??(await Versions.GetActiveVersionAsync())?.Code??versions.FirstOrDefault()?.Code??"";if(version=="")return;books=await Bible.GetBooksAsync(version);bookId=RequestedBook is > 0&&books.Any(x=>x.BookReferenceId==RequestedBook.Value)?RequestedBook.Value:books.FirstOrDefault()?.BookReferenceId??0;chapter=RequestedChapter is > 0?RequestedChapter.Value:1;await Load(RequestedVerse);}async Task Load(int? focusVerse=null){if(version==""||bookId==0)return;books=await Bible.GetBooksAsync(version);verses=await Bible.GetVersesAsync(version,bookId,chapter);start=end=focusVerse is > 0&&verses.Any(x=>x.Verse==focusVerse.Value)?focusVerse.Value:0;pendingScrollVerse=start>0?start:null;message=verses.Count==0?"Capítulo não encontrado.":focusVerse is > 0&&start==0?"Versículo não encontrado neste capítulo.":null;}protected override async Task OnAfterRenderAsync(bool firstRender){if(pendingScrollVerse is int verse){pendingScrollVerse=null;await JS.InvokeVoidAsync("bibliaTema.scrollToVerse",verse);}}async Task Previous(){if(chapter>1){chapter--;await Load();}}async Task Next(){chapter++;await Load();}void Select(int n){if(start==0){start=end=n;}else if(start==end&&start==n){start=end=0;}else if(start==end){var a=Math.Min(start,n);end=Math.Max(start,n);start=a;}else{start=end=n;}}bool Selected(int n)=>start>0&&n>=start&&n<=end;async Task Copy(){var text=string.Join(" ",verses.Where(v=>Selected(v.Verse)).Select(v=>$"{v.Verse} {v.Text}"));await JS.InvokeVoidAsync("navigator.clipboard.writeText",text+" — "+SelectionLabel);}async Task Save(){await Saved.GetOrCreateCanonicalAsync(bookId,chapter,start,end,versions.First(x=>x.Code==version).Id,[]);message="Referência guardada com sucesso.";}}
