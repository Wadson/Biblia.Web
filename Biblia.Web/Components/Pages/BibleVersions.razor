@page "/versoes"
@rendermode InteractiveServer
@inject Biblia.Application.Interfaces.IBibleVersionManager Manager
@inject Biblia.Application.Interfaces.IBibleVersionImportService Importer
<PageTitle>Versões bíblicas — BíbliaTema</PageTitle>
<div class="bible-versions-page"><PageHeader Title="Versões bíblicas" Eyebrow="BÍBLIA" />
<BibleImportPanel Imported="Imported" />
@if(error is not null){<div class="notice error" role="alert">@error</div>}
@if(message is not null){<div class="notice success">@message</div>}
<div class="table-wrap bible-versions-table"><table><thead><tr><th>Versão</th><th>Status</th><th>Validação</th><th>Ações</th></tr></thead><tbody>@foreach(var v in versions){var isActive=string.Equals(v.Code,active,StringComparison.OrdinalIgnoreCase);<tr class="@(v.Code==highlight?"imported-highlight":string.Empty)"><td data-label="Versão"><strong class="bible-version-code">@v.Code</strong><span class="bible-version-name">@v.DisplayName</span><small class="bible-version-meta">@v.Language · schema @v.SchemaVersion</small></td><td data-label="Status"><div class="version-state"><AppIcon Name="check" /><div>@if(isActive){<strong>Ativa</strong>}<span>@(v.IsEnabled?"Habilitada":"Desabilitada")</span><small>@(v.IsBundled?"Empacotada":"Importada")</small></div></div></td><td data-label="Validação"><div class="version-state @(v.ValidationStatus==BibleVersionValidationStatus.Incompatible?"is-invalid":null)"><AppIcon Name="check" /><div><strong>@ValidationLabel(v.ValidationStatus)</strong><small>@v.ValidationMessage</small></div></div></td><td data-label="Ações"><div class="bible-version-actions"><ConfirmButton Label="Definir ativa" Title="Alterar versão ativa" Message="Deseja definir esta versão como ativa?" Summary="@v.DisplayName" CssClass="btn btn-action" ConfirmCssClass="btn btn-action" Disabled="@isActive" OnConfirm="()=>Activate(v.Code)" /><ConfirmButton Label="@(v.IsEnabled?"Desativar":"Ativar")" Title="Alterar disponibilidade" Message="Deseja alterar a disponibilidade desta versão?" Summary="@v.Code" CssClass="btn btn-outline-primary" ConfirmCssClass="btn btn-action" OnConfirm="()=>Toggle(v)" /><button class="btn btn-outline-action" @onclick="()=>Validate(v.Code)"><AppIcon Name="check" /> Validar</button>@if(!v.IsBundled){<ConfirmButton Label="Remover" ConfirmLabel="Remover" Title="Confirmar remoção" Message="@($"Deseja realmente remover a versão bíblica \"{v.Code}\"?")" Summary="@v.DisplayName" Danger="true" CssClass="btn btn-delete-outline" ConfirmCssClass="btn btn-delete" OnConfirm="()=>Remove(v.Code)" />}</div></td></tr>}</tbody></table></div></div>
@code{IReadOnlyList<BibleVersionCatalogEntry> versions=[];string? active,message,error,highlight;static string ValidationLabel(BibleVersionValidationStatus status)=>status switch{BibleVersionValidationStatus.Compatible=>"Compatível",BibleVersionValidationStatus.CompatibleWithCaveat=>"Compatível com ressalvas",BibleVersionValidationStatus.Incompatible=>"Incompatível",_=>"Pendente"};async Task Imported(string code){highlight=code;await Load();}async Task Remove(string code){try{await Importer.RemoveImportedAsync(code);await Load();message="Versão removida.";}catch(Exception ex){error=ex.Message;}}async Task Validate(string code){try{message=(await Manager.ValidateAsync(code)).Message;await Load();}catch(Exception ex){error=ex.Message;}}protected override async Task OnInitializedAsync()=>await Load();async Task Load(){versions=await Manager.GetVersionsAsync();active=(await Manager.GetActiveVersionAsync())?.Code;}async Task Activate(string code){try{error=null;await Manager.SetActiveVersionAsync(code);message="Versão ativa alterada com sucesso.";await Load();}catch(Exception ex){error=ex.Message;}}async Task Toggle(BibleVersionCatalogEntry v){try{error=null;await Manager.SetEnabledAsync(v.Code,!v.IsEnabled);message="Disponibilidade alterada com sucesso.";await Load();}catch(Exception ex){error=ex.Message;}}}
