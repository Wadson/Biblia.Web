@page "/versoes"
@rendermode InteractiveServer
@inject Biblia.Application.Interfaces.IBibleVersionManager Manager
@inject Biblia.Application.Interfaces.IBibleVersionImportService Importer
<PageTitle>Versões bíblicas — BíbliaTema</PageTitle><PageHeader Title="Versões bíblicas" Eyebrow="BÍBLIA" Subtitle="Gerencie as traduções instaladas e ativas." />
<BibleImportPanel Imported="Imported" />
@if(error is not null){<div class="notice error" role="alert">@error</div>}
@if(message is not null){<div class="notice success">@message</div>}<div class="table-wrap"><table><thead><tr><th>Versão</th><th>Status</th><th>Validação</th><th>Ações</th></tr></thead><tbody>@foreach(var v in versions){<tr class="@(v.Code==highlight?"imported-highlight":string.Empty)"><td><strong>@v.Code</strong><br />@v.DisplayName<br /><small>@v.Language · schema @v.SchemaVersion</small></td><td>@(v.Code==active?"Ativa · ":"")@(v.IsEnabled?"Habilitada":"Desabilitada")<br />@(v.IsBundled?"Empacotada":"Importada")</td><td>@v.ValidationStatus<br /><small>@v.ValidationMessage</small></td><td><ConfirmButton Label="Definir ativa" Title="Alterar versão ativa" Message="Deseja definir esta versão como ativa?" Summary="@v.DisplayName" OnConfirm="()=>Activate(v.Code)" /> <ConfirmButton Label="@(v.IsEnabled?"Desativar":"Ativar")" Title="Alterar disponibilidade" Message="Deseja alterar a disponibilidade desta versão?" Summary="@v.Code" OnConfirm="()=>Toggle(v)" CssClass="btn secondary" /> <button class="btn secondary" @onclick="()=>Validate(v.Code)">Validar</button> @if(!v.IsBundled){<ConfirmButton Label="Remover" Title="Remover versão importada" Message="Deseja remover a versão? Vínculos dependentes impedem a remoção." Summary="@v.DisplayName" Danger="true" OnConfirm="()=>Remove(v.Code)" />}</td></tr>}</tbody></table></div>
@code{IReadOnlyList<BibleVersionCatalogEntry> versions=[];string? active,message,error,highlight;async Task Imported(string code){highlight=code;await Load();}async Task Remove(string code){try{await Importer.RemoveImportedAsync(code);await Load();message="Versão removida.";}catch(Exception ex){error=ex.Message;}}async Task Validate(string code){try{message=(await Manager.ValidateAsync(code)).Message;await Load();}catch(Exception ex){error=ex.Message;}}protected override async Task OnInitializedAsync()=>await Load();async Task Load(){versions=await Manager.GetVersionsAsync();active=(await Manager.GetActiveVersionAsync())?.Code;}async Task Activate(string code){await Manager.SetActiveVersionAsync(code);message="Versão ativa alterada com sucesso.";await Load();}async Task Toggle(BibleVersionCatalogEntry v){await Manager.SetEnabledAsync(v.Code,!v.IsEnabled);message="Disponibilidade alterada com sucesso.";await Load();}}
