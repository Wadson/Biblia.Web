@page "/"
@inject Biblia.Application.Interfaces.IDailyVerseService Daily
@inject Biblia.Application.Interfaces.IReportService Reports
<PageTitle>Início — BíbliaTema</PageTitle><PageHeader Title="BíbliaTema" Eyebrow="BEM-VINDO" Subtitle="Sua jornada de estudo, organização e inspiração." ShowBack="false" />
@if(daily is not null){<section class="hero"><span class="badge">@daily.Category</span><blockquote>“@daily.BibleText”</blockquote><strong>@daily.ReferenceText · @daily.BibleVersionCode</strong><a class="btn primary" href="biblia">Ler capítulo inteiro <AppIcon Name="next" Size="sm" /></a></section>}
<h2>Visão geral</h2>@if(stats is not null){<div class="stats"><div><b>@stats.Themes</b><span>Temas</span></div><div><b>@stats.References</b><span>Referências</span></div><div><b>@stats.ReferencesWithComments</b><span>Refs. comentadas</span></div><div><b>@stats.ThemeVerseLinks</b><span>Vínculos temáticos</span></div></div>}
<h2>Acessos rápidos</h2><div class="quick-grid"><a href="biblia"><AppIcon Name="book" Size="lg" /><b>Ler a Bíblia</b><span>Escolha livro e capítulo</span></a><a href="pesquisar-biblia"><AppIcon Name="search" Size="lg" /><b>Pesquisar</b><span>Encontre palavras</span></a><a href="temas"><AppIcon Name="theme" Size="lg" /><b>Temas</b><span>Organize seus estudos</span></a><a href="temas/vincular-versiculos"><AppIcon Name="add" Size="lg" /><b>Vincular</b><span>Associe versículos a temas</span></a><a href="referencias"><AppIcon Name="star" Size="lg" /><b>Referências</b><span>Reveja trechos guardados</span></a><a href="relatorios"><AppIcon Name="report" Size="lg" /><b>Relatórios</b><span>Exporte em PDF</span></a></div>
@code{Biblia.Application.Interfaces.DailyVerse? daily;ReportsOverview? stats;protected override async Task OnInitializedAsync(){daily=await Daily.GetDailyVerseAsync();stats=await Reports.GetOverviewAsync();}}
