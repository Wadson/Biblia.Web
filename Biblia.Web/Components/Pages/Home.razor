@page "/"
@inject Biblia.Application.Interfaces.IDailyVerseService Daily
@inject Biblia.Application.Interfaces.IReportService Reports
<PageTitle>Início — BíbliaTema</PageTitle>
<div class="home-page"><PageHeader Title="BíbliaTema" Eyebrow="BEM-VINDO" ShowBack="false" />
@if(daily is not null){<section class="daily-verse-card"><span class="daily-category">@daily.Category</span><blockquote>“@daily.BibleText”</blockquote><footer><strong>@daily.ReferenceText · @daily.BibleVersionCode</strong><a class="daily-reading-link" href="@DailyVerseRoute(daily)">Ler capítulo inteiro <AppIcon Name="next" Size="sm" /></a></footer></section>}
<section class="home-section"><h2>Visão geral</h2>@if(stats is not null){<div class="overview-grid"><div><b>@stats.Themes</b><span>Temas</span></div><div><b>@stats.References</b><span>Referências</span></div><div><b>@stats.ReferencesWithComments</b><span>Refs. comentadas</span></div><div><b>@stats.ThemeVerseLinks</b><span>Vínculos temáticos</span></div></div>}</section>
<section class="home-section"><h2>Acessos rápidos</h2><div class="home-quick-grid"><a href="biblia"><AppIcon Name="book" Size="lg" /><b>Ler Bíblia</b><span>Escolha livro e capítulo</span></a><a href="pesquisar-biblia"><AppIcon Name="search" Size="lg" /><b>Pesquisar</b><span>Encontre palavras</span></a><a href="temas">@if(stats is not null){<em>@stats.Themes</em>}<AppIcon Name="theme" Size="lg" /><b>Temas</b><span>Organize seus estudos</span></a><a href="temas/vincular-versiculos">@if(stats is not null){<em>@stats.ThemeVerseLinks</em>}<AppIcon Name="add" Size="lg" /><b>Vincular</b><span>Associe versículos a temas</span></a><a href="referencias">@if(stats is not null){<em>@stats.References</em>}<AppIcon Name="star" Size="lg" /><b>Referências</b><span>Reveja trechos guardados</span></a><a href="relatorios"><AppIcon Name="report" Size="lg" /><b>Relatórios</b><span>Exporte em PDF</span></a></div></section></div>
@code{Biblia.Application.Interfaces.DailyVerse? daily;ReportsOverview? stats;protected override async Task OnInitializedAsync(){daily=await Daily.GetDailyVerseAsync();stats=await Reports.GetOverviewAsync();}static string DailyVerseRoute(Biblia.Application.Interfaces.DailyVerse verse)=>$"biblia?version={Uri.EscapeDataString(verse.BibleVersionCode)}&book={verse.BookReferenceId}&chapter={verse.Chapter}&verse={verse.Verse}";}
