@page "/organizacao"
@rendermode InteractiveServer
@inject Biblia.Application.Interfaces.IPublicationService Publications
<PageTitle>Igreja / Ministério — BíbliaTema</PageTitle>
<PageHeader Title="Igreja / Ministério" Eyebrow="IDENTIDADE" Subtitle="A logomarca é armazenada no banco e usada nos cabeçalhos dos PDFs." />
@if(error is not null){<div class="notice error">@error</div>}@if(note is not null){<div class="notice success">@note</div>}
<section class="panel"><div class="form-grid"><label>Nome da igreja/ministério *<input @bind="name" maxlength="160" /></label><label>Logomarca PNG ou JPG (até 5 MB)<InputFile OnChange="SelectLogo" accept="image/png,image/jpeg" /></label></div>
@if(preview is not null){<div style="margin:1rem 0"><img src="@preview" alt="Prévia da logomarca" style="max-height:140px;max-width:360px;object-fit:contain" /></div>}else{<p class="muted">Nenhuma logomarca cadastrada. O PDF continuará sendo gerado normalmente.</p>}
<div class="toolbar"><button class="btn primary" @onclick="Save">Salvar</button><button class="btn secondary" disabled="@(logo is null)" @onclick="Remove">Remover logomarca</button></div></section>
@code { string name="",type="";byte[]? logo;string? preview,error,note;protected override async Task OnInitializedAsync(){var item=await Publications.GetBrandingAsync();if(item is not null){name=item.Name;logo=item.Logo;type=item.LogoContentType??"";preview=logo is null?null:$"data:{type};base64,{Convert.ToBase64String(logo)}";}}async Task SelectLogo(InputFileChangeEventArgs e){try{error=null;var f=e.File;if(f.Size>5*1024*1024)throw new InvalidOperationException("A imagem deve ter no máximo 5 MB.");if(f.ContentType is not ("image/png" or "image/jpeg"))throw new InvalidOperationException("Selecione um PNG ou JPG válido.");await using var input=f.OpenReadStream(5*1024*1024);using var memory=new MemoryStream();await input.CopyToAsync(memory);logo=memory.ToArray();type=f.ContentType;preview=$"data:{type};base64,{Convert.ToBase64String(logo)}";}catch(Exception ex){error=ex.Message;}}async Task Save(){try{await Publications.SaveBrandingAsync(name,logo,type);note="Identidade visual salva.";}catch(Exception ex){error=ex.Message;}}async Task Remove(){logo=null;type="";preview=null;await Save();note="Logomarca removida.";} }
