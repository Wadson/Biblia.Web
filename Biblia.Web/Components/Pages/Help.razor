@page "/ajuda"
@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>Ajuda - BíbliaTema</PageTitle>
<PageHeader Title="Ajuda e manual do usuário" Eyebrow="SISTEMA" Subtitle="Um guia prático para organizar conteúdos e gerar seus PDFs." />

<div class="help-page">
<section class="panel help-hero"><div class="help-hero-copy"><span class="badge">MANUAL BÍBLIATEMA</span><h2>Encontre a orientação que precisa</h2><p>Pesquise uma tarefa ou siga o fluxo completo para criar uma publicação, organizar o conteúdo e gerar o PDF.</p></div><div class="manual-search"><label for="manual-search">Procurar no manual...</label><div class="manual-search-input"><AppIcon Name="search" /><input id="manual-search" @bind="search" @bind:event="oninput" placeholder="Ex.: backup, tema, PDF ou versículo" autocomplete="off" /></div>@if(Suggestions.Any()){<div class="manual-suggestions" role="listbox">@foreach(var item in Suggestions){<button type="button" role="option" @onclick="()=>OpenTopic(item.Id)"><AppIcon Name="@item.Icon" Size="sm" /><span><strong>@item.Title</strong><small>@item.Description</small></span><AppIcon Name="next" Size="sm" /></button>}</div>}</div></section>

<section class="panel quick-start"><div class="section-heading"><div><span class="badge">INÍCIO RÁPIDO</span><h2>Seu primeiro PDF em 5 passos</h2></div><button class="btn secondary" type="button" @onclick="ExpandAll"><AppIcon Name="add" Size="sm" /> Expandir tudo</button></div><div class="quick-stepper">@foreach(var step in QuickSteps){<button type="button" class="@QuickClass(step.Id)" @onclick="()=>OpenTopic(step.Id)"><span class="quick-step-number">@step.Number</span><span><strong>@step.Title</strong><small>@step.Description</small></span></button>}</div><div class="help-callout info"><AppIcon Name="report" /><span><strong>Importante:</strong> o conteúdo é organizado dentro de cada publicação. Ao usar um tema em outra publicação, vincule e organize o conteúdo desejado nessa publicação.</span></div></section>

<div class="help-layout"><aside class="panel help-index" aria-label="Índice do manual"><div class="index-heading"><AppIcon Name="book" /><div><span>ÍNDICE</span><h2>Navegue pelo manual</h2></div></div><details open><summary>Primeiros passos</summary><button class="@ActiveClass(Inicio)" @onclick="()=>OpenTopic(Inicio)">Preparar o sistema</button><button class="@ActiveClass(Biblia)" @onclick="()=>OpenTopic(Biblia)">Bíblia e versões</button></details><details open><summary>Produzir seu material</summary><button class="@ActiveClass(Temas)" @onclick="()=>OpenTopic(Temas)">Temas e publicações</button><button class="@ActiveClass(Vinculacao)" @onclick="()=>OpenTopic(Vinculacao)">Vincular conteúdo</button><button class="@ActiveClass(Vinculos)" @onclick="()=>OpenTopic(Vinculos)">Revisar vínculos</button><button class="@ActiveClass(Pdf)" @onclick="()=>OpenTopic(Pdf)">Gerar o PDF</button></details><details open><summary>Manutenção</summary><button class="@ActiveClass(Sistema)" @onclick="()=>OpenTopic(Sistema)">Configurações e backup</button></details><div class="index-tip"><AppIcon Name="settings" Size="sm" /><span>Use a busca acima para localizar uma ação rapidamente.</span></div></aside>

<main class="help-content"><section class="help-shortcut-grid"><button type="button" @onclick="()=>OpenTopic(Vinculacao)"><AppIcon Name="add" /><span><strong>Vincular versículos</strong><small>Escolha publicação, tema e conteúdo.</small></span></button><button type="button" @onclick="()=>OpenTopic(Pdf)"><AppIcon Name="report" /><span><strong>Gerar um PDF</strong><small>Escolha os temas e faça o download.</small></span></button><button type="button" @onclick="()=>OpenTopic(Sistema)"><AppIcon Name="settings" /><span><strong>Fazer backup</strong><small>Proteja seus dados antes de mudanças maiores.</small></span></button></section>

<details class="@TopicClass(Inicio)" id="inicio" open="@IsExpanded(Inicio)"><summary class="topic-trigger" @onclick="()=>ToggleTopic(Inicio)"><span class="topic-number">1</span><span><small>PRIMEIROS PASSOS</small><strong>Prepare o sistema</strong><em>Versão bíblica e identidade da igreja</em></span><AppIcon Name="down" /></summary><div class="topic-body"><p>Antes de montar uma publicação, mantenha ao menos uma versão bíblica válida, habilitada e ativa. Em <span class="ui-tag">Igreja / Ministério</span>, informe o nome da organização e, se desejar, inclua uma logomarca PNG ou JPG. Esses dados podem compor o cabeçalho do PDF.</p><div class="help-callout success"><AppIcon Name="check" /><span>Depois dessa preparação, siga para <span class="ui-tag">Publicação</span> e <span class="ui-tag">Temas</span>.</span></div></div></details>

<details class="@TopicClass(Biblia)" id="biblia" open="@IsExpanded(Biblia)"><summary class="topic-trigger" @onclick="()=>ToggleTopic(Biblia)"><span class="topic-number">2</span><span><small>BÍBLIA</small><strong>Versões, leitura, pesquisa e comparação</strong><em>Consulte a Bíblia da forma que preferir</em></span><AppIcon Name="down" /></summary><div class="topic-body"><h3>Versões bíblicas</h3><p>Em <span class="ui-tag">Configurações</span>, abra <span class="ui-tag">Gerenciar versões bíblicas</span>. Para anexar uma tradução, escolha um arquivo <span class="ui-tag">.sqlite</span> ou <span class="ui-tag">.db</span>, informe o código e nome corretos e use <span class="ui-tag">Anexar versão bíblica</span>. Valide o arquivo e defina uma versão como ativa.</p><h3>Leitura, pesquisa e comparação</h3><p>Em <span class="ui-tag">Ler Bíblia</span>, escolha versão, livro e capítulo. Use <span class="ui-tag">-A</span> e <span class="ui-tag">+A</span> para ajustar a leitura. Em <span class="ui-tag">Pesquisar</span>, informe ao menos dois caracteres e selecione uma ou todas as versões instaladas. Em <span class="ui-tag">Comparar versões</span>, escolha uma referência para ver a passagem nas traduções habilitadas.</p></div></details>

<details class="@TopicClass(Temas)" id="temas" open="@IsExpanded(Temas)"><summary class="topic-trigger" @onclick="()=>ToggleTopic(Temas)"><span class="topic-number">3</span><span><small>ESTRUTURA</small><strong>Crie publicações e temas</strong><em>Defina o livro e os assuntos que o compõem</em></span><AppIcon Name="down" /></summary><div class="topic-body"><h3>Publicação</h3><p>Em <span class="ui-tag">Publicação</span>, use <span class="ui-tag">Nova publicação</span>, informe o <span class="ui-tag">Título do PDF</span>, o subtítulo opcional e o texto adicional. Na etapa seguinte, configure cores, tipografia e aparência do cabeçalho com a prévia ao lado.</p><h3>Tema</h3><p>Em <span class="ui-tag">Temas</span>, clique em <span class="ui-tag">Novo tema</span>, informe o nome, uma cor opcional e selecione a publicação que receberá o vínculo. Ao editar, use <span class="ui-tag">Vincular publicação</span> para associar o mesmo tema a outras publicações, uma por vez.</p><div class="help-callout warning"><AppIcon Name="theme" /><span>Um tema pode estar em várias publicações. A listagem mostra todas as publicações vinculadas a ele.</span></div></div></details>

<details class="@TopicClass(Vinculacao)" id="vinculacao" open="@IsExpanded(Vinculacao)"><summary class="topic-trigger" @onclick="()=>ToggleTopic(Vinculacao)"><span class="topic-number">4</span><span><small>CONTEÚDO</small><strong>Vincule versículos, observações e blocos</strong><em>Siga o funil: publicação, tema, versículos e organização</em></span><AppIcon Name="down" /></summary><div class="topic-body"><h3>Escolha o destino</h3><p>Abra <span class="ui-tag">Vincular versículos</span> e escolha primeiro a <span class="ui-tag">Publicação / PDF</span>. O filtro <span class="ui-tag">Tema</span> exibirá somente os temas vinculados a essa publicação. Se voltar a publicação para <span class="ui-tag">Selecione</span>, os filtros e seleções seguintes são limpos.</p><h3>Selecione os versículos</h3><p>Depois escolha versão, livro e capítulo. Marque um ou mais e use <span class="ui-tag">Salvar vinculação</span>. Versículos já vinculados aparecem identificados. Use <span class="ui-tag">-A</span> e <span class="ui-tag">+A</span> para ajustar a fonte e <span class="ui-tag">Bíblia</span> para voltar rapidamente à área de seleção.</p><h3>Observações, blocos e ordem</h3><p>Salve a observação para que ela seja incluída no PDF. Use <span class="ui-tag">Adicionar bloco de texto</span> para introduções ou transições; o editor permite texto multilinha, cor, tamanho, marcador, negrito e itálico. Organize com a ordem manual ou use <span class="ui-tag">Usar ordem bíblica automática</span>.</p></div></details>

<details class="@TopicClass(Vinculos)" id="visao-vinculos" open="@IsExpanded(Vinculos)"><summary class="topic-trigger" @onclick="()=>ToggleTopic(Vinculos)"><span class="topic-number">5</span><span><small>REVISÃO</small><strong>Confira as vinculações</strong><em>Veja os temas e conteúdos de cada publicação</em></span><AppIcon Name="down" /></summary><div class="topic-body"><p>Abra <span class="ui-tag">Vinculações</span> para revisar os temas de cada publicação sem editar diretamente. Pesquise pelo título ou tema e filtre por data ou status. A tabela mostra os totais de temas, versículos e blocos registrados para cada publicação.</p><p>Use <span class="ui-tag">Ver detalhes</span> para ver os totais de cada tema e <span class="ui-tag">Abrir na tela de Vinculação de Versículos</span> para editar o conteúdo. <span class="ui-tag">Exportar lista em PDF</span> abre a janela de impressão para salvar a relação.</p></div></details>

<details class="@TopicClass(Pdf)" id="pdf" open="@IsExpanded(Pdf)"><summary class="topic-trigger" @onclick="()=>ToggleTopic(Pdf)"><span class="topic-number">6</span><span><small>FINALIZAÇÃO</small><strong>Gere, baixe e imprima o PDF</strong><em>Escolha a publicação e confirme o arquivo final</em></span><AppIcon Name="down" /></summary><div class="topic-body"><p>Em <span class="ui-tag">Relatório</span>, escolha a <span class="ui-tag">Publicação / PDF</span>. O filtro de temas exibirá somente os temas vinculados a ela; selecione um tema ou <span class="ui-tag">Todos os temas</span>. O título definido na publicação é usado automaticamente.</p><p>Clique em <span class="ui-tag">Gerar relatório</span>. Ao concluir, aparecerá a etapa <span class="ui-tag">2 - Baixar PDF</span>. Use <span class="ui-tag">Baixar PDF gerado</span> para salvar, compartilhar ou imprimir.</p></div></details>

<details class="@TopicClass(Sistema)" id="sistema" open="@IsExpanded(Sistema)"><summary class="topic-trigger" @onclick="()=>ToggleTopic(Sistema)"><span class="topic-number">7</span><span><small>MANUTENÇÃO</small><strong>Configurações, atualização e backup</strong><em>Mantenha o aplicativo e seus dados protegidos</em></span><AppIcon Name="down" /></summary><div class="topic-body"><p>Em <span class="ui-tag">Configurações</span>, você administra versões bíblicas, ordenação, tipografia do PDF, atualizações e cópias de segurança. A prévia de tipografia permite conferir os tamanhos antes de salvar.</p><div class="help-callout warning"><AppIcon Name="file" /><span><strong>Backup:</strong> use <span class="ui-tag">Fazer backup</span> antes de importar versões, restaurar dados ou realizar alterações em grande escala. Para recuperar seus dados, escolha <span class="ui-tag">Restaurar backup</span>, aguarde o término e não feche o aplicativo.</span></div><h3>Atualizações</h3><p>O aplicativo consulta o arquivo <span class="ui-tag">version.json</span> publicado no GitHub ao iniciar. Quando houver uma versão mais recente, o aviso aparecerá. Em Configurações, use <span class="ui-tag">Baixar atualização</span> e confirme <span class="ui-tag">Instalar e reiniciar</span>.</p></div></details>
</main></div></div>

@code {
    private const string Inicio="inicio", Biblia="biblia", Temas="temas", Vinculacao="vinculacao", Vinculos="visao-vinculos", Pdf="pdf", Sistema="sistema";
    private string search=string.Empty; private string? activeTopic=Inicio; private string? pendingTopic; private readonly HashSet<string> expandedTopics=[Inicio];
    private sealed record ManualTopic(string Id,string Title,string Description,string Icon,string Keywords);
    private static readonly IReadOnlyList<ManualTopic> Topics=[new(Inicio,"Preparar o sistema","Versão bíblica e Igreja / Ministério","settings","início igreja ministério logo preparar"),new(Biblia,"Bíblia e versões","Leitura, pesquisa, comparação e versões","book","bíblia versão leitura pesquisar comparação sqlite db"),new(Temas,"Temas e publicações","Crie títulos, temas e vínculos","theme","tema publicação título criar editar cor"),new(Vinculacao,"Vincular conteúdo","Versículos, observações, blocos e ordenação","add","vincular versículo bloco observação ordem bíblia"),new(Vinculos,"Revisar vinculações","Consulte os temas e conteúdos por publicação","search","vinculações detalhes revisar exportar"),new(Pdf,"Gerar o PDF","Prepare, baixe ou imprima o relatório","report","pdf relatório gerar baixar imprimir"),new(Sistema,"Configurações e backup","Atualizações, tipografia e cópias de segurança","settings","configurações backup restaurar atualização version json")];
    private static readonly IReadOnlyList<(int Number,string Id,string Title,string Description)> QuickSteps=[(1,Inicio,"Prepare","Versão e igreja"),(2,Temas,"Estruture","Publicação e tema"),(3,Vinculacao,"Vincule","Versículos e blocos"),(4,Vinculos,"Revise","Confira vínculos"),(5,Pdf,"Finalize","Gere o PDF")];
    private IEnumerable<ManualTopic> Suggestions=>string.IsNullOrWhiteSpace(search)?[]:Topics.Where(x=>($"{x.Title} {x.Description} {x.Keywords}").Contains(search,StringComparison.OrdinalIgnoreCase)).Take(5);
    private string ActiveClass(string topic)=>activeTopic==topic?"active":string.Empty; private string QuickClass(string topic)=>"quick-step "+ActiveClass(topic); private string TopicClass(string topic)=>"panel help-topic "+(activeTopic==topic?"is-active":string.Empty); private bool IsExpanded(string topic)=>expandedTopics.Contains(topic);
    private void ToggleTopic(string topic){activeTopic=topic;if(!expandedTopics.Add(topic))expandedTopics.Remove(topic);} private void ExpandAll(){foreach(var topic in Topics)expandedTopics.Add(topic.Id);} private void OpenTopic(string topic){activeTopic=pendingTopic=topic;expandedTopics.Add(topic);search=string.Empty;}
    protected override async Task OnAfterRenderAsync(bool firstRender){if(pendingTopic is not { } topic)return;pendingTopic=null;await JS.InvokeVoidAsync("bibliaTema.scrollToHelpTopic",topic);}
}
