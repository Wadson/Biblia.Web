@rendermode InteractiveServer
@inject Biblia.Application.Interfaces.ISavedReferenceService Service
@inject Biblia.Application.Interfaces.IBookNameResolver BookNames
@inject Biblia.Application.Interfaces.IThemeService Themes
@inject Biblia.Application.Interfaces.IBibleVersionManager Versions
@inject Biblia.Application.Interfaces.IBibleRepository Bible

<PageTitle>Referências — BíbliaTema</PageTitle>
<PageHeader Title="Referências guardadas" Eyebrow="ESTUDO" />

@if (note is not null) { <div class="notice success">@note</div> }
@if (error is not null) { <div class="notice error">@error</div> }

<section class="panel saved-reference-library"><header><p class="eyebrow">BIBLIOTECA</p><h2>Referências guardadas <span>@displays.Count</span></h2><p class="muted">Consulte e organize suas passagens salvas.</p></header><div class="toolbar saved-reference-search"><label class="field">Pesquisar<input placeholder="Pesquisar referência, comentário ou tema..." @bind="query" /></label><button class="btn secondary" @onclick="Load">Filtrar</button><a class="btn primary" href="/temas/vincular-versiculos">Vincular versículos a um tema</a></div>
@if(selectedReferenceIds.Count>0){<div class="saved-reference-selection-toolbar"><strong>@selectedReferenceIds.Count @(selectedReferenceIds.Count==1?"referência selecionada":"referências selecionadas")</strong><button type="button" class="btn secondary" @onclick="ClearSelection">Limpar seleção</button></div>}<div class="table-wrap reference-table"><table><thead><tr><th><input type="checkbox" aria-label="Selecionar todas as referências visíveis" checked="@AllVisibleSelected" @onchange="ToggleAllVisible" /></th><th>Referência</th><th>Versão</th><th>Comentário</th><th>Temas</th><th>Ações</th></tr></thead><tbody>
@foreach (var item in displays)
{
    <tr class="@(selectedReferenceIds.Contains(item.Details.Reference.Id)?"saved-reference-row-selected":null)"><td><input type="checkbox" aria-label="Selecionar @item.FormattedReference" checked="@selectedReferenceIds.Contains(item.Details.Reference.Id)" @onchange="()=>ToggleReference(item.Details.Reference.Id)" /></td><td><strong>@item.FormattedReference</strong></td><td>@(item.EffectiveVersionCode is null ? "Não disponível" : $"{item.EffectiveVersionCode} — {item.EffectiveVersionName}")</td><td>@(string.IsNullOrWhiteSpace(item.Details.Reference.Comment)?"—":item.Details.Reference.Comment)</td><td><div class="theme-chips">@foreach(var theme in item.Details.Themes){<span style="--theme-color:@theme.ColorHex">@theme.Name</span>}</div></td><td><div class="saved-reference-row-actions"><ConfirmButton Label="Excluir" ConfirmLabel="Excluir" Title="Confirmar exclusão" Message="@($"Excluir a referência {item.FormattedReference}?")" Summary="Esta ação não pode ser desfeita." Danger="true" CssClass="btn btn-delete" ConfirmCssClass="btn btn-delete" OnConfirm="() => Delete(item.Details.Reference.Id)" /></div></td></tr>
}
</tbody></table></div></section>

@code {
    private IReadOnlyList<SavedReferenceDetails> items = [];
    private IReadOnlyList<ReferenceDisplay> displays = [];
    private IReadOnlyList<Theme> themes = [];
    private IReadOnlyList<BibleVersionCatalogEntry> versions = [];
    private IReadOnlyList<BibleBook> books = [];
    private HashSet<long> selected = [];
    private HashSet<long> selectedReferenceIds = [];
    private long? editId;
    private long versionId;
    private int book = 1, chapter = 1, start = 1, end = 1;
    private string comment = "", query = "";
    private string? note, error;
    private string CurrentFormattedReference => Biblia.Domain.Rules.BibleReferenceFormatter.Format(books.FirstOrDefault(x => x.BookReferenceId == book)?.Name ?? $"Livro não disponível (cód. {book})", chapter, start, end);

    protected override async Task OnInitializedAsync()
    {
        themes = await Themes.SearchAsync(null);
        versions = (await Versions.GetVersionsAsync()).Where(x => x.IsInstalled && x.IsEnabled && x.ValidationStatus != BibleVersionValidationStatus.Incompatible).ToArray();
        var active = await Versions.GetActiveVersionAsync();
        if (active is not null) books = await Bible.GetBooksAsync(active.Code);
        book = books.FirstOrDefault()?.BookReferenceId ?? 1;
        await Load();
    }

    private async Task Load()
    {
        items = await Service.SearchAsync(null);
        var resolved = await BookNames.ResolveAsync(items);
        displays = string.IsNullOrWhiteSpace(query) ? resolved : resolved.Where(x => x.FormattedReference.Contains(query, StringComparison.OrdinalIgnoreCase) || (x.Details.Reference.Comment?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false) || x.Details.Themes.Any(t => t.Name.Contains(query, StringComparison.OrdinalIgnoreCase))).ToArray();
    }

    private void ToggleTheme(long id) { if(!selected.Add(id)) selected.Remove(id); }
    private bool AllVisibleSelected => displays.Count>0 && displays.All(x=>selectedReferenceIds.Contains(x.Details.Reference.Id));
    private void ToggleReference(long id) { if(!selectedReferenceIds.Add(id)) selectedReferenceIds.Remove(id); }
    private void ToggleAllVisible() { if(AllVisibleSelected) foreach(var item in displays) selectedReferenceIds.Remove(item.Details.Reference.Id); else foreach(var item in displays) selectedReferenceIds.Add(item.Details.Reference.Id); }
    private void ClearSelection()=>selectedReferenceIds.Clear();
    private void CancelEdit(){editId=null;comment="";selected=[];versionId=0;chapter=start=end=1;error=null;}
    private void Edit(SavedReferenceDetails details) { var r = details.Reference; editId = r.Id; book = r.BookReferenceId; chapter = r.Chapter; start = r.VerseStart; end = r.VerseEnd; comment = r.Comment ?? ""; versionId = r.PreferredBibleVersionId ?? 0; selected = details.Themes.Select(x => x.Id).ToHashSet(); }
    private async Task Save()
    {
        error = note = null;
        try
        {
            var effective = versionId == 0 ? await Versions.GetActiveVersionAsync() : versions.FirstOrDefault(x => x.Id == versionId);
            if (effective is null) throw new InvalidOperationException("Selecione uma versão bíblica disponível.");
            var passage = await Bible.GetPassageAsync(effective.Code, book, chapter, start, end);
            if (passage.Verses.Select(x => x.Verse).Distinct().Count() != end - start + 1 || passage.HasAmbiguities) throw new InvalidOperationException("Livro, capítulo ou intervalo inexistente na versão selecionada.");
            await Service.SaveAsync(editId, book, chapter, start, end, comment, effective.Id, selected);
            note = "Referência salva com sucesso."; editId = null; comment = ""; selected = []; await Load();
        }
        catch (Exception ex) { error = ex.Message; }
    }
    private async Task Delete(long id) { await Service.DeleteAsync(id); selectedReferenceIds.Remove(id); if(editId==id) CancelEdit(); note = "Referência excluída com sucesso."; await Load(); }
}
