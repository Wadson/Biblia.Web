@inject IJSRuntime JS
@inject NavigationManager Navigation
<header class="page-header app-page-header"><div class="page-header-side">@if(ShowBack){<button type="button" class="btn secondary" title="Voltar à tela anterior" aria-label="Voltar à tela anterior" @onclick="GoBack"><AppIcon Name="back" Size="md" /> Voltar</button>}</div><div class="page-header-title">@if(!string.IsNullOrWhiteSpace(Eyebrow)){<p class="eyebrow">@Eyebrow</p>}<h1>@Title</h1>@if(!string.IsNullOrWhiteSpace(Subtitle)){<p class="muted">@Subtitle</p>}</div><div class="page-header-side end"><a class="btn secondary" href="/" title="Ir para o início" aria-label="Ir para o início"><AppIcon Name="home" Size="md" /> Início</a></div></header>
@code{[Parameter]public string Title{get;set;}="";[Parameter]public string Eyebrow{get;set;}="BÍBLIATEMA";[Parameter]public string? Subtitle{get;set;}[Parameter]public bool ShowBack{get;set;}=true;[Parameter]public string Fallback{get;set;}="/";async Task GoBack(){var used=await JS.InvokeAsync<bool>("bibliaTema.goBack");if(!used)Navigation.NavigateTo(Fallback);}}
