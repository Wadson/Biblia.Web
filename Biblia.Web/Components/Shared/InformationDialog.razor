@if (Visible)
{
    <div class="modal-backdrop" role="presentation" @onclick="Close" @onkeydown="HandleKey" tabindex="-1">
        <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="information-title" @onclick:stopPropagation>
            <h2 id="information-title">@Title</h2><p>@Message</p>
            <div class="dialog-actions"><button class="btn primary" autofocus @onclick="Close">Fechar</button></div>
        </div>
    </div>
}
@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Title { get; set; } = "Informação";
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }
    private Task Close() => OnClose.InvokeAsync();
    private Task HandleKey(KeyboardEventArgs args) => args.Key == "Escape" ? Close() : Task.CompletedTask;
}
