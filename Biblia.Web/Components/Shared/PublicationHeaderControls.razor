@using Biblia.Domain.Entities
<section class="panel"><h3>Tipografia e logomarca do cabeçalho</h3><div class="form-grid"><label>Nome da igreja — tamanho<input type="number" min="7" max="36" @bind="Publication.OrganizationFontSize" /></label><label>Nome da igreja — cor<input type="color" @bind="OrganizationColor" /></label><label>Subtítulo — tamanho<input type="number" min="7" max="36" @bind="Publication.SubtitleFontSize" /></label><label>Subtítulo — cor<input type="color" @bind="SubtitleColor" /></label><label>Texto adicional — tamanho<input type="number" min="7" max="36" @bind="Publication.HeaderDetailFontSize" /></label><label>Texto adicional — cor<input type="color" @bind="DetailColor" /></label><label>Logo — largura<input type="number" min="20" max="160" @bind="Publication.LogoWidth" /></label><label>Logo — altura<input type="number" min="20" max="100" @bind="Publication.LogoHeight" /></label></div></section>
@code { [Parameter,EditorRequired] public Publication Publication{get;set;}=null!;[Parameter] public string OrganizationColor{get;set;}="#FFFFFF";[Parameter] public string SubtitleColor{get;set;}="#FFFFFF";[Parameter] public string DetailColor{get;set;}="#C7DCFF"; }
