<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["typography.css"]" />
    <link rel="stylesheet" href="@Assets["Biblia.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="appicon.svg" />
    <link rel="alternate icon" type="image/png" href="appicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>window.bibliaTema={goBack:function(){if(history.length>1){history.back();return true;}return false;},scrollToVerse:function(verse){document.getElementById('verse-'+verse)?.scrollIntoView({behavior:'smooth',block:'center'});},scrollToHelpTopic:function(topic){document.getElementById(topic)?.scrollIntoView({behavior:'smooth',block:'start'});},scrollToLinkerSelection:function(){const target=document.getElementById('encontre-versiculos');if(!target)return;const top=Math.max(0,target.getBoundingClientRect().top+window.scrollY-12);window.scrollTo({top:top,behavior:'smooth'});target.classList.remove('is-highlighted');void target.offsetWidth;target.classList.add('is-highlighted');setTimeout(()=>target.classList.remove('is-highlighted'),1800);}};</script>
    <script>
        (() => {
            const key = "biblia-web-browser-session";
            const id = sessionStorage.getItem(key) || crypto.randomUUID();
            sessionStorage.setItem(key, id);
            const endpoint = name => `/_biblia/${name}?id=${encodeURIComponent(id)}`;
            const notifyOpen = () => fetch(endpoint("browser-open"), { method: "POST", keepalive: true }).catch(() => {});
            notifyOpen();
            window.addEventListener("pagehide", () => navigator.sendBeacon(endpoint("browser-closed"), ""));
        })();
    </script>
</body>

</html>
